{% schema %}
{
  "name": "Custom Collection Grid",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections to Display",
      "limit": 4
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<div class="collection-grid-section">
  <style>
        .collection-grid {
          display: flex;
          flex-wrap: wrap;
          gap: 20px;
        }

        .collection-grid-section .collection-grid .collection-item:nth-child(4) {
          display: none !important;
        }
        .collection-item {
            flex: 1 1 calc(25% - 20px);
            text-align: center;
            position: relative;
            background: #fafafa;
            border-radius: 25px;
            padding: 10px;
        }
        .collection-item img {
          width: 100%;
          height: auto;
          border-radius: 5px;
        }
        .collection-icon {
          font-size: 1em;
        }

        /* Mobile styles */
        @media (max-width: 768px) {
    .collection-grid {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: 0px !important;
        flex-wrap: nowrap;
    }
          .collection-item {
            flex: 0 0 80%;
            scroll-snap-align: center;
          }
        }
  </style>

  <div class="collection-grid">
    {% for collection in collections %}
      <div class="collection-item">
        <a href="{{ collection.url }}">
          <img src="{{ collection.image.src | img_url: 'medium' }}" height="" width="" alt="{{ collection.title }}">
          <div class="collection-title">
            <span class="item-heading">{{ collection.title }}</span>
            <span class="collection-icon">
              <svg fill="#000000" width="20px" height="20px" viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg" id="arrow">
  <path d="M8.29289 2.29289C8.68342 1.90237 9.31658 1.90237 9.70711 2.29289L14.2071 6.79289C14.5976 7.18342 14.5976 7.81658 14.2071 8.20711L9.70711 12.7071C9.31658 13.0976 8.68342 13.0976 8.29289 12.7071C7.90237 12.3166 7.90237 11.6834 8.29289 11.2929L11 8.5H1.5C0.947715 8.5 0.5 8.05228 0.5 7.5C0.5 6.94772 0.947715 6.5 1.5 6.5H11L8.29289 3.70711C7.90237 3.31658 7.90237 2.68342 8.29289 2.29289Z"/>
</svg>
            </span>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    if (window.innerWidth <= 768) {
      const grid = document.querySelector('.collection-grid');
      grid.style.display = 'flex';
      grid.style.overflowX = 'scroll';
      grid.scrollSnapType = 'x mandatory';
    }
  });
</script>
