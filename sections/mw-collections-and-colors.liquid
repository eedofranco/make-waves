{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --mw-cac-arrow-size: {{ section.settings.arrow_size }}px;
    --mw-cac-arrow-bg: rgba({{ section.settings.arrow_bg_color | color_to_rgb | remove: 'rgb(' | remove: ')' }}, {{ section.settings.arrow_bg_opacity | divided_by: 100.0 }});
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .mw-cac-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .mw-cac-header {
    margin-bottom: 3rem;
  }

  .mw-cac-heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
  }

  .mw-cac-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 3rem;
  }

  @media screen and (min-width: 750px) {
    .mw-cac-grid {
      grid-template-columns: repeat(min(var(--cac-columns, 3), 2), 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .mw-cac-grid {
      grid-template-columns: repeat(min(var(--cac-columns, 3), 6), 1fr);
    }
  }

  .mw-cac-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: #ffffff;
    padding-bottom: var(--cac-extra-bottom, 0px);
  }

  .mw-cac-card__image-wrapper {
    position: relative;
    aspect-ratio: 681 / 851;
    background-color: #f8f8f8;
    overflow: hidden;
  }

  .mw-cac-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mw-cac-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mw-cac-card__img.mw-cac-card__img--loading {
    opacity: 0.7;
  }

  .mw-cac-card__badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background-color: #000000;
    color: #ffffff;
    padding: 0.4rem 0.8rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    z-index: 2;
  }

  .mw-cac-card__wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border: none;
    background: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .mw-cac-card__wishlist:hover {
    transform: scale(1.15);
  }

  .mw-cac-card__wishlist svg {
    display: block;
  }

  .mw-cac-card__wishlist--active svg path {
    fill: #e74c3c;
    stroke: #e74c3c;
  }

  .mw-cac-card__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    row-gap: 1rem;
  }

  .mw-cac-card__info-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
    flex-shrink: 0;
  }

  .mw-cac-card__info-right {
    display: flex;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .mw-cac-card__price {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 700;
    color: #000000;
  }

  .mw-cac-card__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
  }

  .mw-cac-card__shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    padding: 0.5rem 1.6rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.1rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .mw-cac-card__shop-btn:hover {
    background-color: #ffffff;
    color: #000000;
  }

  .mw-cac-card__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
    padding-top: 0.5rem;
    flex-basis: 100%;
    justify-content: flex-start;
    min-height: 2.1rem;
  }

  .mw-cac-card__swatches:empty {
    display: flex;
  }

  .mw-cac-card__swatch {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 0;
    position: relative;
    background-size: cover;
    background-position: center;
    transition: transform 0.2s ease;
  }

  .mw-cac-card__swatch.active {
    transform: scale(1.15);
  }

  .mw-cac-card__swatch::after {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    z-index: 1;
    pointer-events: none;
    transition: border-color 0.2s ease;
  }

  .mw-cac-card__swatch.active::after {
    border-color: #000000;
  }

  .mw-cac-card__swipe-arrow {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .mw-cac-card__swipe-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 4;
      width: var(--mw-cac-arrow-size);
      height: var(--mw-cac-arrow-size);
      border-radius: 50%;
      background: var(--mw-cac-arrow-bg);
      border: none;
      cursor: pointer;
      color: #000000;
      opacity: 0.6;
      transition: opacity 0.2s ease;
    }

    .mw-cac-card__swipe-arrow:active,
    .mw-cac-card__swipe-arrow:focus-visible {
      opacity: 0.9;
      outline: none;
    }

    .mw-cac-card__swipe-arrow--left {
      left: 0;
    }

    .mw-cac-card__swipe-arrow--right {
      right: 0;
    }

    .mw-cac-card__swipe-arrow svg {
      width: 50%;
      height: 50%;
      stroke-width: 2.5;
    }

    .mw-cac-card__swipe-arrow[hidden] {
      display: none;
    }

    .mw-cac-card__image-wrapper {
      user-select: none;
      touch-action: pan-y pinch-zoom;
    }

    .mw-cac-card__img.is-dragging {
      transition: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign blocks_count = section.blocks | size
  if blocks_count > 6
    assign blocks_count = 6
  endif
-%}

<div class="mw-cac-container color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <div class="mw-cac-header">
      <h2 class="mw-cac-heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="mw-cac-grid" style="--cac-columns: {{ blocks_count }}; --cac-extra-bottom: {{ section.settings.extra_bottom_padding }}px;">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_image = block.settings.image
        assign card_link = block.settings.link
        assign card_title = block.settings.title
        assign no_link = block.settings.no_link
        assign badge_text = block.settings.badge_text
        assign button_text = block.settings.button_text
        if button_text == blank
          assign button_text = 'products.product.shop' | t | default: 'SHOP'
        endif

        if card_title == blank and card_image == blank and block.settings.product_1 == blank and block.settings.product_2 == blank and block.settings.product_3 == blank and block.settings.product_4 == blank
          continue
        endif
      -%}

      {%- liquid
        assign image_src = nil
        assign image_alt = nil
        assign first_product = nil
        assign all_swatch_data = ''
        assign first_variant_image = ''
        assign first_variant_hover_image = ''

        if card_image != blank
          assign image_src = card_image
          assign image_alt = card_image.alt | default: ''
        endif

        assign rendered_colors = '||'
        for i in (1..4)
          if i == 1
            assign prod = block.settings.product_1
          elsif i == 2
            assign prod = block.settings.product_2
          elsif i == 3
            assign prod = block.settings.product_3
          else
            assign prod = block.settings.product_4
          endif

          if prod == blank
            continue
          endif
          if first_product == nil
            assign first_product = prod
          endif
          if image_src == blank and prod.featured_media != blank
            assign image_src = prod.featured_media
            assign image_alt = prod.featured_media.alt | default: ''
          endif
          assign color_opt_index = -1
          for option in prod.options_with_values
            assign opt_downcase = option.name | downcase
            if opt_downcase contains 'color' or opt_downcase contains 'colour' or opt_downcase contains 'tinte'
              assign color_opt_index = forloop.index0
              break
            endif
          endfor
          if color_opt_index >= 0
            assign color_opt = prod.options_with_values[color_opt_index]
            for value in color_opt.values
              assign value_key = value | downcase | strip
              assign check = '||' | append: value_key | append: '||'
              unless rendered_colors contains check
                assign rendered_colors = rendered_colors | append: value_key | append: '||'
                assign variant_for_value = nil
                for variant in prod.variants
                  if variant.options[color_opt_index] == value
                    assign variant_for_value = variant
                    break
                  endif
                endfor
                assign swatch_bg = 'transparent'
                if value.swatch.color
                  assign swatch_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                elsif value.swatch.image
                  assign swatch_img_url = value.swatch.image | image_url: width: 50
                  assign swatch_bg = 'url(' | append: swatch_img_url | append: ')'
                else
                  case value_key
                    when 'sand', 'make waves sand'
                      assign swatch_bg = '#e2dcd0'
                    when 'olive'
                      assign swatch_bg = '#5b6251'
                    when 'indigo', 'craft stories indigo'
                      assign swatch_bg = '#2c3539'
                    when 'navy'
                      assign swatch_bg = '#1d2731'
                    when 'slate'
                      assign swatch_bg = '#5c6b73'
                    when 'black'
                      assign swatch_bg = '#111111'
                    when 'white'
                      assign swatch_bg = '#ffffff'
                    when 'cream'
                      assign swatch_bg = '#f5f5dc'
                    when 'green', 'dark green'
                      assign swatch_bg = '#2d4a3e'
                    when 'teal', 'dark teal'
                      assign swatch_bg = '#2a4d4f'
                    when 'grey', 'gray'
                      assign swatch_bg = '#808080'
                    else
                      assign swatch_bg = value_key
                  endcase
                endif
                assign variant_image = ''
                assign variant_hover_image = ''
                assign variant_color_str = variant_for_value.options[color_opt_index] | downcase | strip
                for gallery_entry in prod.metafields.custom.mw_galleries.value
                  assign entry_color_label = gallery_entry.variant_color.value.label | downcase | strip
                  if entry_color_label == variant_color_str
                    for gal_img in gallery_entry.product_gallery.value
                      if forloop.index == 1
                        assign variant_image = gal_img | image_url: width: 600
                      elsif forloop.index == 2
                        assign variant_hover_image = gal_img | image_url: width: 600
                        break
                      endif
                    endfor
                    break
                  endif
                endfor
                if variant_image == '' and variant_for_value and variant_for_value.featured_media
                  assign variant_image = variant_for_value.featured_media | image_url: width: 600
                elsif variant_image == ''
                  assign variant_image = prod.featured_media | image_url: width: 600
                endif
                if variant_hover_image == '' and prod.media.size > 1
                  assign variant_hover_image = prod.media[1] | image_url: width: 600
                endif
                if first_variant_image == ''
                  assign first_variant_image = variant_image
                  assign first_variant_hover_image = variant_hover_image
                endif
                assign entry = value_key | append: ':::' | append: swatch_bg | append: ':::' | append: variant_image | append: ':::' | append: value | escape | append: ':::' | append: variant_hover_image
                assign all_swatch_data = all_swatch_data | append: entry | append: '|||'
              endunless
            endfor
          endif
        endfor

        assign can_link = false
        if no_link == false and card_link != blank
          assign can_link = true
        endif

        assign default_image_url = nil
        assign default_hover_image_url = nil
        if card_image != blank
          assign default_image_url = image_src | image_url: width: 600
          if first_variant_hover_image != ''
            assign default_hover_image_url = first_variant_hover_image
          endif
        elsif first_variant_image != ''
          assign default_image_url = first_variant_image
          assign default_hover_image_url = first_variant_hover_image
        elsif first_product != nil and first_product.featured_media != blank
          assign default_image_url = first_product.featured_media | image_url: width: 600
          if first_product.media.size > 1
            assign default_hover_image_url = first_product.media[1] | image_url: width: 600
          endif
        endif
      -%}

      <div class="mw-cac-card" {{ block.shopify_attributes }} data-default-image="{{ default_image_url }}" data-default-hover-image="{{ default_hover_image_url }}">
        <div class="mw-cac-card__image-wrapper">
          {%- if badge_text != blank -%}
            <div class="mw-cac-card__badge">{{ badge_text | escape }}</div>
          {%- endif -%}

          {%- if first_product != nil -%}
            <button class="mw-cac-card__wishlist" data-product-id="{{ first_product.id }}" aria-label="Add to wishlist">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18">
                <path d="M10 17.5L3.5 11a4.5 4.5 0 0 1 6.5-6.2 4.5 4.5 0 0 1 6.5 6.2L10 17.5z" fill="none" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </button>
          {%- endif -%}

          {%- if all_swatch_data != '' -%}
            <button class="mw-cac-card__swipe-arrow mw-cac-card__swipe-arrow--left" type="button" aria-label="Previous color">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="mw-cac-card__swipe-arrow mw-cac-card__swipe-arrow--right" type="button" aria-label="Next color">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          {%- endif -%}

          {%- if default_image_url != nil -%}
            {%- if can_link -%}
              <a href="{{ card_link }}" class="mw-cac-card__image-link">
            {%- else -%}
              <div class="mw-cac-card__image-link">
            {%- endif -%}
              <img
                src="{{ default_image_url }}"
                alt="{{ image_alt | escape }}"
                class="mw-cac-card__img"
                loading="lazy"
                width="600"
                height="750"
              >
            {%- if can_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="mw-cac-card__image-link" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; height: 100%;">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div class="mw-cac-card__info">
          <div class="mw-cac-card__info-left">
            <h3 class="mw-cac-card__title">
              {%- if can_link and card_title != blank -%}
                <a href="{{ card_link }}" style="text-decoration: none; color: inherit;">{{ card_title | escape }}</a>
              {%- else -%}
                {{ card_title | default: '' | escape }}
              {%- endif -%}
            </h3>
            {%- if can_link -%}
              <a href="{{ card_link }}" class="mw-cac-card__shop-btn">{{ button_text | escape }}</a>
            {%- else -%}
              <span class="mw-cac-card__shop-btn">{{ button_text | escape }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.price != blank -%}
            <div class="mw-cac-card__info-right">
              <span class="mw-cac-card__price">{{ block.settings.price | escape }}</span>
            </div>
          {%- endif -%}

          <div class="mw-cac-card__swatches">
            {%- if all_swatch_data != '' -%}
              {%- assign swatch_entries = all_swatch_data | split: '|||' -%}
              {%- for swatch_entry in swatch_entries -%}
                {%- if swatch_entry == '' -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign parts = swatch_entry | split: ':::' -%}
                {%- if parts.size >= 3 -%}
                  <button
                    class="mw-cac-card__swatch{% if forloop.index == 1 %} active{% endif %}"
                    style="background: {{ parts[1] }};"
                    data-variant-image="{{ parts[2] }}"
                    data-variant-hover-image="{{ parts[4] }}"
                    aria-label="Color {{ parts[3] }}"
                  ></button>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="mw-cac-card">
          <div class="mw-cac-card__image-wrapper">
            <div class="mw-cac-card__badge">COLLECTION</div>
            <div class="mw-cac-card__image-link" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; height: 100%;">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
          <div class="mw-cac-card__info">
            <div class="mw-cac-card__info-left">
              <h3 class="mw-cac-card__title">Collection {{ i }}</h3>
              <a href="#" class="mw-cac-card__shop-btn">SHOP</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function() {
    var preloaded = {};

    function preloadImage(url) {
      if (!url || preloaded[url]) return;
      var img = new Image();
      img.src = url;
      preloaded[url] = img;
    }

    function preloadAll(images) {
      for (var i = 0; i < images.length; i++) {
        preloadImage(images[i]);
      }
    }

    function swapImage(img, newSrc) {
      if (!img || !newSrc) return;
      if (img.getAttribute('src') === newSrc) return;

      if (preloaded[newSrc] && preloaded[newSrc].complete) {
        img.classList.remove('mw-cac-card__img--loading');
        img.setAttribute('src', newSrc);
        return;
      }

      img.classList.add('mw-cac-card__img--loading');

      var temp = new Image();
      temp.onload = function() {
        img.setAttribute('src', newSrc);
        img.classList.remove('mw-cac-card__img--loading');
        preloaded[newSrc] = temp;
      };
      temp.onerror = function() {
        img.setAttribute('src', newSrc);
        img.classList.remove('mw-cac-card__img--loading');
      };
      temp.src = newSrc;
    }

    function initWishlist() {
      var section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;
      var btns = section.querySelectorAll('.mw-cac-card__wishlist');
      for (var i = 0; i < btns.length; i++) {
        (function(btn) {
          var pid = btn.getAttribute('data-product-id');
          if (pid && localStorage.getItem('mw_wishlist_' + pid) === 'true') {
            btn.classList.add('mw-cac-card__wishlist--active');
          }
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var productId = btn.getAttribute('data-product-id');
            if (!productId) return;
            var liked = localStorage.getItem('mw_wishlist_' + productId) === 'true';
            if (liked) {
              localStorage.removeItem('mw_wishlist_' + productId);
              btn.classList.remove('mw-cac-card__wishlist--active');
            } else {
              localStorage.setItem('mw_wishlist_' + productId, 'true');
              btn.classList.add('mw-cac-card__wishlist--active');
            }
          });
        })(btns[i]);
      }
    }

    function initCacSwatches() {
      var section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;

      var allImages = [];
      var cards = section.querySelectorAll('.mw-cac-card');

      for (var c = 0; c < cards.length; c++) {
        (function(card) {
          var img = card.querySelector('.mw-cac-card__img');
          var imageWrapper = card.querySelector('.mw-cac-card__image-wrapper');
          if (!img || !imageWrapper) return;

          var defaultImage = card.getAttribute('data-default-image');
          var defaultHoverImage = card.getAttribute('data-default-hover-image');
          var activeSwatch = null;

          if (defaultImage) allImages.push(defaultImage);
          if (defaultHoverImage) allImages.push(defaultHoverImage);

          imageWrapper.addEventListener('mouseenter', function() {
            if (activeSwatch) {
              var hoverSrc = activeSwatch.getAttribute('data-variant-hover-image');
              swapImage(img, hoverSrc || activeSwatch.getAttribute('data-variant-image'));
            } else {
              swapImage(img, defaultHoverImage || defaultImage);
            }
          });

          imageWrapper.addEventListener('mouseleave', function() {
            activeSwatch = null;
            swapImage(img, defaultImage);
          });

          var swatches = card.querySelectorAll('.mw-cac-card__swatch');
          for (var s = 0; s < swatches.length; s++) {
            (function(swatch) {
              var variantImage = swatch.getAttribute('data-variant-image');
              var variantHoverImage = swatch.getAttribute('data-variant-hover-image');
              if (variantImage) allImages.push(variantImage);
              if (variantHoverImage) allImages.push(variantHoverImage);

              swatch.addEventListener('mouseenter', function(e) {
                e.stopPropagation();
                activeSwatch = swatch;
                for (var j = 0; j < swatches.length; j++) {
                  swatches[j].classList.remove('active');
                }
                swatch.classList.add('active');
                swapImage(img, variantImage);
              });

              swatch.addEventListener('mouseleave', function(e) {
                swatch.classList.remove('active');
                if (imageWrapper.contains(e.relatedTarget)) {
                  swapImage(img, variantHoverImage || variantImage);
                }
              });
            })(swatches[s]);
          }

          var swipeLeft = card.querySelector('.mw-cac-card__swipe-arrow--left');
          var swipeRight = card.querySelector('.mw-cac-card__swipe-arrow--right');

          if (swipeLeft && swipeRight && swatches.length > 1) {
            function getSwatchIndex() {
              for (var j = 0; j < swatches.length; j++) {
                if (swatches[j] === activeSwatch) return j;
              }
              return 0;
            }

            swipeLeft.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              var idx = getSwatchIndex();
              var newIdx = idx - 1;
              if (newIdx < 0) newIdx = swatches.length - 1;
              var swatch = swatches[newIdx];
              activeSwatch = swatch;
              for (var j = 0; j < swatches.length; j++) {
                swatches[j].classList.remove('active');
              }
              swatch.classList.add('active');
              var newSrc = swatch.getAttribute('data-variant-image');
              preloadImage(newSrc);
              swapImage(img, newSrc);
            });

            swipeRight.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              var idx = getSwatchIndex();
              var newIdx = idx + 1;
              if (newIdx >= swatches.length) newIdx = 0;
              var swatch = swatches[newIdx];
              activeSwatch = swatch;
              for (var j = 0; j < swatches.length; j++) {
                swatches[j].classList.remove('active');
              }
              swatch.classList.add('active');
              var newSrc = swatch.getAttribute('data-variant-image');
              preloadImage(newSrc);
              swapImage(img, newSrc);
            });

            var dragState = { startX: 0, deltaX: 0, tracking: false };
            var DRAG_THRESHOLD = 40;
            var DRAG_DAMPEN = 0.7;

            imageWrapper.addEventListener('touchstart', function dragStart(e) {
              dragState.startX = e.touches[0].clientX;
              dragState.deltaX = 0;
              dragState.tracking = true;
            }, { passive: true });

            imageWrapper.addEventListener('touchmove', function dragMove(e) {
              if (!dragState.tracking) return;
              dragState.deltaX = e.touches[0].clientX - dragState.startX;
              var tx = dragState.deltaX * DRAG_DAMPEN;
              if (Math.abs(tx) < 100) {
                img.style.transform = 'translateX(' + tx + 'px)';
                img.classList.add('is-dragging');
              }
            }, { passive: true });

            imageWrapper.addEventListener('touchend', function dragEnd() {
              if (!dragState.tracking) return;
              dragState.tracking = false;
              img.classList.remove('is-dragging');

              if (Math.abs(dragState.deltaX) > DRAG_THRESHOLD) {
                var dir = dragState.deltaX < 0 ? -1 : 1;
                var link = imageWrapper.querySelector('.mw-cac-card__image-link');
                if (link) {
                  link.style.pointerEvents = 'none';
                  setTimeout(function() { link.style.pointerEvents = ''; }, 450);
                }

                img.style.transition = 'transform 0.18s ease-in, opacity 0.15s ease-in';
                img.style.transform = 'translateX(' + (dir * 80) + 'px)';
                img.style.opacity = '0';

                setTimeout(function() {
                  if (dir < 0) {
                    swipeRight.click();
                  } else {
                    swipeLeft.click();
                  }

                  img.style.transition = 'none';
                  img.style.transform = 'translateX(' + (-dir * 60) + 'px)';

                  requestAnimationFrame(function() {
                    requestAnimationFrame(function() {
                      img.style.transition = 'transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease-out';
                      img.style.transform = '';
                      img.style.opacity = '';
                    });
                  });
                }, 180);
              } else {
                img.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
                img.style.transform = '';
                img.style.opacity = '';
              }
            });
          } else if (swipeLeft && swipeRight) {
            swipeLeft.setAttribute('hidden', '');
            swipeRight.setAttribute('hidden', '');
          }
        })(cards[c]);
      }

      preloadAll(allImages);
      initWishlist();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCacSwatches);
    } else {
      initCacSwatches();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initCacSwatches();
      }
    });
  })();
</script>

