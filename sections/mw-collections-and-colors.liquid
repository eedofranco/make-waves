{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .mw-cac-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .mw-cac-header {
    margin-bottom: 3rem;
  }

  .mw-cac-heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
  }

  .mw-cac-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 3rem;
  }

  @media screen and (min-width: 750px) {
    .mw-cac-grid {
      grid-template-columns: repeat(min(var(--cac-columns, 3), 2), 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .mw-cac-grid {
      grid-template-columns: repeat(min(var(--cac-columns, 3), 6), 1fr);
    }
  }

  .mw-cac-card {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
  }

  .mw-cac-card__image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: #f8f8f8;
    overflow: hidden;
  }

  .mw-cac-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mw-cac-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mw-cac-card__img.mw-cac-card__img--loading {
    opacity: 0.7;
  }

  .mw-cac-card:hover .mw-cac-card__img {
    transform: scale(1.03);
  }

  .mw-cac-card__badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background-color: #000000;
    color: #ffffff;
    padding: 0.4rem 0.8rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    z-index: 2;
  }

  .mw-cac-card__wishlist {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border: none;
    background: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .mw-cac-card__wishlist:hover {
    transform: scale(1.15);
  }

  .mw-cac-card__wishlist svg {
    display: block;
  }

  .mw-cac-card__wishlist--active svg path {
    fill: #e74c3c;
    stroke: #e74c3c;
  }

  .mw-cac-card__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
  }

  .mw-cac-card__info-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .mw-cac-card__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
  }

  .mw-cac-card__shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    padding: 0.5rem 1.6rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.1rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .mw-cac-card__shop-btn:hover {
    background-color: #ffffff;
    color: #000000;
  }

  .mw-cac-card__swatches {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    padding-top: 0.5rem;
  }

  .mw-cac-card__swatch {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 0;
    position: relative;
    background-size: cover;
    background-position: center;
    transition: transform 0.2s ease;
  }

  .mw-cac-card__swatch.active {
    transform: scale(1.15);
  }

  .mw-cac-card__swatch::after {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    z-index: 1;
    pointer-events: none;
    transition: border-color 0.2s ease;
  }

  .mw-cac-card__swatch.active::after {
    border-color: #000000;
  }
{%- endstyle -%}

{%- liquid
  assign blocks_count = section.blocks | size
  if blocks_count > 6
    assign blocks_count = 6
  endif
-%}

<div class="mw-cac-container color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.heading != blank -%}
    <div class="mw-cac-header">
      <h2 class="mw-cac-heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="mw-cac-grid" style="--cac-columns: {{ blocks_count }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign collection = block.settings.collection
        assign product = block.settings.product
        assign badge_text = block.settings.badge_text
        assign button_text = block.settings.button_text
        if button_text == blank
          assign button_text = 'products.product.shop' | t | default: 'SHOP'
        endif
        if collection == blank and product == blank
          continue
        endif
      -%}

      {%- liquid
        assign color_option = null
        assign color_option_index = 0
        if product != blank
          for option in product.options_with_values
            assign option_name_downcase = option.name | downcase
            if option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'tinte'
              assign color_option = option
              assign color_option_index = forloop.index0
              break
            endif
          endfor
        endif
      -%}

      <div class="mw-cac-card" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
        <div class="mw-cac-card__image-wrapper">
          {%- if badge_text != blank -%}
            <div class="mw-cac-card__badge">{{ badge_text | escape }}</div>
          {%- endif -%}

          <button class="mw-cac-card__wishlist" data-product-id="{{ product.id }}" aria-label="Add to wishlist">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18">
              <path d="M10 17.5L3.5 11a4.5 4.5 0 0 1 6.5-6.2 4.5 4.5 0 0 1 6.5 6.2L10 17.5z" fill="none" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </button>

          {%- if product != blank and product.featured_media != blank -%}
            <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ product.url }}{% endif %}" class="mw-cac-card__image-link">
              <img
                src="{{ product.featured_media | image_url: width: 600 }}"
                alt="{{ product.featured_media.alt | escape }}"
                class="mw-cac-card__img"
                width="600"
                height="600"
              >
            </a>
          {%- elsif collection != blank and collection.image != blank -%}
            <a href="{{ collection.url }}" class="mw-cac-card__image-link">
              <img
                src="{{ collection.image | image_url: width: 600 }}"
                alt="{{ collection.title | escape }}"
                class="mw-cac-card__img"
                loading="lazy"
                width="600"
                height="600"
              >
            </a>
          {%- else -%}
            <div class="mw-cac-card__image-link" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; height: 100%;">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <div class="mw-cac-card__info">
          <div class="mw-cac-card__info-left">
            <h3 class="mw-cac-card__title">
              {%- if collection != blank -%}
                <a href="{{ collection.url }}" style="text-decoration: none; color: inherit;">{{ collection.title | escape }}</a>
              {%- else -%}
                {{ 'N/A' | escape }}
              {%- endif -%}
            </h3>
            <a href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}" class="mw-cac-card__shop-btn">{{ button_text | escape }}</a>
          </div>

          {%- if color_option -%}
            <div class="mw-cac-card__swatches">
              {%- for value in color_option.values -%}
                {%- liquid
                  assign variant_for_value = null
                  for variant in product.variants
                    if variant.options[color_option_index] == value
                      assign variant_for_value = variant
                      break
                    endif
                  endfor

                  assign swatch_bg = 'transparent'
                  if value.swatch.color
                    assign swatch_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                  elsif value.swatch.image
                    assign image_url = value.swatch.image | image_url: width: 50
                    assign swatch_bg = 'url(' | append: image_url | append: ')'
                  else
                    assign color_key = value | downcase | strip
                    case color_key
                      when 'sand' or 'make waves sand'
                        assign swatch_bg = '#e2dcd0'
                      when 'olive'
                        assign swatch_bg = '#5b6251'
                      when 'indigo' or 'craft stories indigo'
                        assign swatch_bg = '#2c3539'
                      when 'navy'
                        assign swatch_bg = '#1d2731'
                      when 'slate'
                        assign swatch_bg = '#5c6b73'
                      when 'black'
                        assign swatch_bg = '#111111'
                      when 'white'
                        assign swatch_bg = '#ffffff'
                      when 'cream'
                        assign swatch_bg = '#f5f5dc'
                      when 'green' or 'dark green'
                        assign swatch_bg = '#2d4a3e'
                      when 'teal' or 'dark teal'
                        assign swatch_bg = '#2a4d4f'
                      when 'grey' or 'gray'
                        assign swatch_bg = '#808080'
                      else
                        assign swatch_bg = color_key
                    endcase
                  endif

                  if variant_for_value and variant_for_value.featured_media
                    assign variant_image = variant_for_value.featured_media | image_url: width: 600
                  else
                    assign variant_image = product.featured_media | image_url: width: 600
                  endif
                -%}
                <button
                  class="mw-cac-card__swatch{% if forloop.first %} active{% endif %}"
                  style="background: {{ swatch_bg }};"
                  data-variant-image="{{ variant_image }}"
                  aria-label="Color {{ value | escape }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="mw-cac-card">
          <div class="mw-cac-card__image-wrapper">
            <div class="mw-cac-card__badge">COLLECTION</div>
            <div class="mw-cac-card__image-link" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; height: 100%;">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
          <div class="mw-cac-card__info">
            <div class="mw-cac-card__info-left">
              <h3 class="mw-cac-card__title">Collection {{ i }}</h3>
              <a href="#" class="mw-cac-card__shop-btn">SHOP</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

<script>
  (function() {
    var preloaded = {};

    function preloadImage(url) {
      if (preloaded[url]) return;
      var img = new Image();
      img.src = url;
      preloaded[url] = img;
    }

    function preloadAll(images) {
      for (var i = 0; i < images.length; i++) {
        preloadImage(images[i]);
      }
    }

    function swapImage(img, newSrc) {
      if (!img || !newSrc) return;
      if (img.getAttribute('src') === newSrc) return;

      if (preloaded[newSrc] && preloaded[newSrc].complete) {
        img.classList.remove('mw-cac-card__img--loading');
        img.setAttribute('src', newSrc);
        return;
      }

      img.classList.add('mw-cac-card__img--loading');

      var temp = new Image();
      temp.onload = function() {
        img.setAttribute('src', newSrc);
        img.classList.remove('mw-cac-card__img--loading');
        preloaded[newSrc] = temp;
      };
      temp.onerror = function() {
        img.setAttribute('src', newSrc);
        img.classList.remove('mw-cac-card__img--loading');
      };
      temp.src = newSrc;
    }

    function initWishlist() {
      var section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;
      var btns = section.querySelectorAll('.mw-cac-card__wishlist');
      for (var i = 0; i < btns.length; i++) {
        (function(btn) {
          var pid = btn.getAttribute('data-product-id');
          if (pid && localStorage.getItem('mw_wishlist_' + pid) === 'true') {
            btn.classList.add('mw-cac-card__wishlist--active');
          }
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var productId = btn.getAttribute('data-product-id');
            if (!productId) return;
            var liked = localStorage.getItem('mw_wishlist_' + productId) === 'true';
            if (liked) {
              localStorage.removeItem('mw_wishlist_' + productId);
              btn.classList.remove('mw-cac-card__wishlist--active');
            } else {
              localStorage.setItem('mw_wishlist_' + productId, 'true');
              btn.classList.add('mw-cac-card__wishlist--active');
            }
          });
        })(btns[i]);
      }
    }

    function initCacSwatches() {
      var section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;

      var allVariantImages = [];

      var swatches = section.querySelectorAll('.mw-cac-card__swatch');
      for (var i = 0; i < swatches.length; i++) {
        var swatch = swatches[i];
        var imgSrc = swatch.getAttribute('data-variant-image');
        if (imgSrc) allVariantImages.push(imgSrc);

        (function(s) {
          s.addEventListener('mouseenter', function() {
            var parentCard = s.closest('.mw-cac-card');
            if (!parentCard) return;

            var cardSwatches = parentCard.querySelectorAll('.mw-cac-card__swatch');
            for (var j = 0; j < cardSwatches.length; j++) {
              cardSwatches[j].classList.remove('active');
            }
            s.classList.add('active');

            var mainImg = parentCard.querySelector('.mw-cac-card__img');
            var newSrc = s.getAttribute('data-variant-image');
            swapImage(mainImg, newSrc);
          });
        })(swatch);
      }

      preloadAll(allVariantImages);
      initWishlist();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCacSwatches);
    } else {
      initCacSwatches();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initCacSwatches();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "MW - Collecc & Colors",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "info": "Leave empty to hide badge"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now",
          "placeholder": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MW - Collecc & Colors",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
