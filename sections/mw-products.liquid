{%- style -%}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .mw-products-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .mw-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  @media screen and (max-width: 989px) {
    .mw-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media screen and (max-width: 749px) {
    .mw-products-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .mw-product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: transparent;
  }

  .mw-product-card__image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: #f8f8f8;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .mw-product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .mw-product-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mw-product-card:hover .mw-product-card__img {
    transform: scale(1.03);
  }

  .mw-product-card__badge {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background-color: #000000;
    color: #ffffff;
    padding: 0.4rem 0.8rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    z-index: 2;
  }

  .mw-product-card__wishlist {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 2;
    padding: 0;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .mw-product-card__wishlist:hover {
    transform: scale(1.15);
  }

  .mw-product-card__wishlist svg {
    width: 1.8rem;
    height: 1.8rem;
    stroke-width: 1.5;
  }

  .mw-product-card__info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .mw-product-card__info-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .mw-product-card__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
  }

  .mw-product-card__title a {
    text-decoration: none;
    color: inherit;
  }

  .mw-product-card__shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    padding: 0.5rem 1.6rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.1rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .mw-product-card__shop-btn:hover {
    background-color: #ffffff;
    color: #000000;
  }

  .mw-product-card__swatches {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    padding-top: 0.5rem;
  }

  .mw-product-card__swatch {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 0;
    position: relative;
    background-size: cover;
    background-position: center;
    transition: transform 0.2s ease;
  }

  .mw-product-card__swatch.active {
    transform: scale(1.15);
  }

  .mw-product-card__swatch::after {
    content: '';
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border-radius: 50%;
    border: 1px solid #e0e0e0;
    z-index: 1;
    pointer-events: none;
    transition: border-color 0.2s ease;
  }

  .mw-product-card__swatch.active::after {
    border-color: #000000;
  }
{%- endstyle -%}

<div class="mw-products-container color-{{ section.settings.color_scheme }} gradient">
  <div class="mw-products-grid">
    {%- assign collection = section.settings.collection -%}
    {%- assign limit = section.settings.products_to_show -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: limit -%}
        
        {%- liquid
          assign color_option = null
          assign color_option_index = 0
          for option in product.options_with_values
            assign option_name_downcase = option.name | downcase
            if option_name_downcase contains 'color' or option_name_downcase contains 'colour' or option_name_downcase contains 'tinte'
              assign color_option = option
              assign color_option_index = forloop.index0
              break
            endif
          endfor
        -%}

        <div class="mw-product-card" data-product-id="{{ product.id }}">
          <div class="mw-product-card__image-wrapper">
            {%- if product.tags contains 'pre-order' or section.settings.show_pre_order_badge -%}
              <div class="mw-product-card__badge">{{ 'products.product.pre_order' | t | default: 'PRE-ORDER' }}</div>
            {%- endif -%}

            <button class="mw-product-card__wishlist" aria-label="Add to wishlist">
              <svg class="icon icon-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </button>

            <a href="{{ product.url }}" class="mw-product-card__image-link">
              <img
                src="{{ product.featured_media | image_url: width: 600 }}"
                alt="{{ product.featured_media.alt | escape }}"
                class="mw-product-card__img"
                loading="lazy"
                width="600"
                height="600"
              >
            </a>
          </div>

          <div class="mw-product-card__info">
            <div class="mw-product-card__info-left">
              <h3 class="mw-product-card__title">
                <a href="{{ product.url }}">{{ product.title | escape }}</a>
              </h3>
              <a href="{{ product.url }}" class="mw-product-card__shop-btn">{{ 'products.product.shop' | t | default: 'SHOP' }}</a>
            </div>

            {%- if color_option -%}
              <div class="mw-product-card__swatches">
                {%- for value in color_option.values -%}
                  {%- liquid
                    assign variant_for_value = null
                    for variant in product.variants
                      if variant.options[color_option_index] == value
                        assign variant_for_value = variant
                        break
                      endif
                    endfor

                    assign swatch_bg = 'transparent'
                    if value.swatch.color
                      assign swatch_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                    elsif value.swatch.image
                      assign image_url = value.swatch.image | image_url: width: 50
                      assign swatch_bg = 'url(' | append: image_url | append: ')'
                    else
                      assign color_key = value | downcase | strip
                      case color_key
                        when 'sand' or 'make waves sand'
                          assign swatch_bg = '#e2dcd0'
                        when 'olive'
                          assign swatch_bg = '#5b6251'
                        when 'indigo' or 'craft stories indigo'
                          assign swatch_bg = '#2c3539'
                        when 'navy'
                          assign swatch_bg = '#1d2731'
                        when 'slate'
                          assign swatch_bg = '#5c6b73'
                        when 'black'
                          assign swatch_bg = '#111111'
                        when 'white'
                          assign swatch_bg = '#ffffff'
                        when 'cream'
                          assign swatch_bg = '#f5f5dc'
                        when 'green' or 'dark green'
                          assign swatch_bg = '#2d4a3e'
                        when 'teal' or 'dark teal'
                          assign swatch_bg = '#2a4d4f'
                        when 'grey' or 'gray'
                          assign swatch_bg = '#808080'
                        else
                          assign swatch_bg = color_key
                      endcase
                    endif

                    if variant_for_value and variant_for_value.featured_media
                      assign variant_image = variant_for_value.featured_media | image_url: width: 600
                    else
                      assign variant_image = product.featured_media | image_url: width: 600
                    endif
                  -%}
                  <button
                    class="mw-product-card__swatch{% if forloop.first %} active{% endif %}"
                    style="background: {{ swatch_bg }};"
                    data-variant-image="{{ variant_image }}"
                    aria-label="Color {{ value | escape }}"
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <div class="mw-product-card">
          <div class="mw-product-card__image-wrapper">
            <div class="mw-product-card__badge">PRE-ORDER</div>
            <button class="mw-product-card__wishlist" aria-label="Add to wishlist">
              <svg class="icon icon-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </button>
            <div class="mw-product-card__image-link" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; height: 100%;">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
          <div class="mw-product-card__info">
            <div class="mw-product-card__info-left">
              <h3 class="mw-product-card__title">Product {{ i }}</h3>
              <a href="#" class="mw-product-card__shop-btn">SHOP</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    function initMwProducts() {
      const section = document.querySelector('#shopify-section-{{ section.id }}');
      if (!section) return;

      const swatches = section.querySelectorAll('.mw-product-card__swatch');
      swatches.forEach(swatch => {
        function updateActiveImage() {
          const parentCard = swatch.closest('.mw-product-card');
          if (!parentCard) return;

          const cardSwatches = parentCard.querySelectorAll('.mw-product-card__swatch');
          cardSwatches.forEach(s => s.classList.remove('active'));
          swatch.classList.add('active');

          const mainImg = parentCard.querySelector('.mw-product-card__img');
          const newSrc = swatch.getAttribute('data-variant-image');
          if (mainImg && newSrc) {
            mainImg.setAttribute('src', newSrc);
            mainImg.setAttribute('srcset', newSrc);
          }
        }

        swatch.addEventListener('click', function(e) {
          e.preventDefault();
          updateActiveImage();
        });

        swatch.addEventListener('mouseenter', function() {
          updateActiveImage();
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMwProducts);
    } else {
      initMwProducts();
    }
    
    // Shopify Theme Editor support
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initMwProducts();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "MW - Products",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_pre_order_badge",
      "default": true,
      "label": "Show Pre-Order Badge"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "MW - Products"
    }
  ]
}
{% endschema %}
