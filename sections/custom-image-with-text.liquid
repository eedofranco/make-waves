{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_horizontal | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_horizontal | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_horizontal }}px;
      padding-right: {{ section.settings.padding_horizontal }}px;
    }
  }

  .custom-media-text--{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  {% if section.settings.mobile_layout == 'reversed' %}
  .custom-media-text--{{ section.id }} {
    flex-direction: column-reverse;
  }
  {% endif %}

  .custom-media-text__media {
    width: 100%;
  }

  .custom-media-text__content {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .custom-media-text--{{ section.id }} {
      flex-direction: row;
      align-items: center;
      gap: 4rem; /* Un poco más de espacio en desktop */
    }

    .custom-media-text__media {
      width: {{ section.settings.media_width }}%;
    }

    .custom-media-text__content {
      width: {{ 100 | minus: section.settings.media_width }}%;
    }
  }

  .custom-media-text__media img,
  .custom-media-text__media video,
  .custom-media-text__media svg {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
  }

  .custom-media-text__media svg {
    background: #f4f4f4;
  }
{%- endstyle -%}

<div class="custom-media-text custom-media-text--{{ section.id }} section-{{ section.id }}-padding">
  <div class="custom-media-text__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="custom-media-text__content">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'text' -%}
          <div class="custom-media-text__text" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "MW Custom Image/Video",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Overrides image if provided"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Media width (Desktop)",
      "default": 35
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "normal",
          "label": "Media First"
        },
        {
          "value": "reversed",
          "label": "Text First (Reversed)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image/Video Text",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
