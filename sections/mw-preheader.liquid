{%- style -%}
  .mw-preheader--{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1.2;
    height: 40px;
    width: 100%;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  {% if section.settings.enable_marquee %}
  .mw-preheader--{{ section.id }} .mw-preheader__track {
    display: flex;
    align-items: center;
    animation: mw-preheader-scroll-{{ section.id }} {{ section.settings.scroll_speed }}s linear infinite;
  }

  .mw-preheader--{{ section.id }} .mw-preheader__group {
    display: flex;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  @keyframes mw-preheader-scroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  {% else %}
  .mw-preheader--{{ section.id }} .mw-preheader__single {
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: {{ section.settings.text_alignment }};
  }
  {% endif %}
{%- endstyle -%}

{% if section.settings.enable_marquee %}
  <div class="mw-preheader mw-preheader--{{ section.id }}" role="region" aria-label="{{ section.settings.text | escape }}">
    <div class="mw-preheader__track">
      {% for i in (1..2) %}
        <div class="mw-preheader__group" {% if forloop.last %}aria-hidden="true"{% endif %}>
          {% for j in (1..3) %}
            <span>{{ section.settings.text | escape }}</span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
{% else %}
  <div class="mw-preheader mw-preheader--{{ section.id }}" role="region" aria-label="{{ section.settings.text | escape }}">
    <div class="mw-preheader__single">
      <span>{{ section.settings.text | escape }}</span>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "MW - Preheader",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Free shipping on orders over $100"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Marquee (infinite scroll)",
      "default": false
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "info": "Only applies when marquee is off",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 2,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Marquee speed",
      "default": 10
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "MW - Preheader"
    }
  ]
}
{% endschema %}
