<div class="custom-form-section">
  <!-- Image Column -->
  <div class="custom-image-section">
    {% if section.settings.custom_image != blank %}
      <img
        src="{{ section.settings.custom_image | img_url: 'master' }}"
        alt="{{ section.settings.custom_image.alt | escape }}"
        loading="lazy"
        width="100%"
        height="100%"
      >
    {% else %}
      <div class="placeholder-image">
        <p>Please select an image in theme customizer</p>
      </div>
    {% endif %}
  </div>

  <!-- Contact Form Column -->
  <div class="contact-form">
    <h2 class="contact-heading">{{ section.settings.form_heading }}</h2>
    <p class="contact-p">{{ section.settings.form_description }}</p>

    <form method="post" action="/contact" enctype="multipart/form-data">
      <div class="main-feilds-for-flex">
        <input type="text" id="name" name="name" placeholder="Name" required>
        <input type="email" id="email" name="email" placeholder="Email Address" required>
      </div>

      <textarea id="message" name="message" placeholder="Message" rows="4" required></textarea>

      <button type="submit">Submit</button>
    </form>
    <div class="main-bottom-logo">
      {% if section.settings.bottom_logo != blank %}
        <img
          src="{{ section.settings.bottom_logo | img_url: 'master' }}"
          alt="{{ section.settings.bottom_logo.alt | escape }}"
          width="{{ section.settings.bottom_logo_width }}px"
          height="100%"
          loading="lazy"
          style="max-width: {{ section.settings.bottom_logo_width }}px; margin: 0 auto;"
        >
      {% endif %}
    </div>
  </div>
</div>

<style>
  .custom-form-section {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 20px;
    padding: 0 20px;
    max-width: 1920px;
    justify-content: center;
  }

  .custom-image-section {
    flex: 1;
    min-width: 300px; /* Minimum width before wrapping */
    max-width: 100%;
    margin: auto;
  }

  .custom-image-section img {
    width: 100%;
    height: auto;
    display: block;
  }

  .placeholder-image {
    background: #f4f4f4;
    padding: 20px;
    text-align: center;
  }

  .contact-form {
    flex: 1;
    max-width: 100%;
    padding: 40px 5% 0;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .main-feilds-for-flex {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  input,
  textarea {
    width: 100%;
    padding: 8px;
  }

  button {
    margin-top: 20px;
  }

  /* Responsive adjustments */
  @media screen and (min-width: 768px) {
    .custom-image-section,
    .contact-form {
      flex: 0 1 calc(50% - 1rem);
    }

    .main-feilds-for-flex {
      flex-direction: row;
    }

    .main-feilds-for-flex input {
      flex: 1;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Form",
  "settings": [
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "form_description",
      "label": "Form Description",
      "default": "Please fill out the form below to get in touch."
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_logo",
      "label": "Bottom Logo Image"
    },
    {
      "type": "range",
      "id": "bottom_logo_width",
      "min": 50,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Bottom Logo Width",
      "default": 200
    }
  ],
  "presets": [
    {
      "name": "Custom Form"
    }
  ]
}
{% endschema %}
