{%- style -%}
  {%- if section.settings.content_font -%}
    {{ section.settings.content_font | font_face: font_display: 'swap' }}
    {%- assign content_font_bold = section.settings.content_font | font_modify: 'weight', 'bold' -%}
    {%- if content_font_bold -%}
      {{ content_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
  {%- endif -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_horizontal | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_horizontal | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_horizontal }}px;
      padding-right: {{ section.settings.padding_horizontal }}px;
    }
  }

  .custom-media-text--{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  {% if section.settings.mobile_layout == 'reversed' %}
  .custom-media-text--{{ section.id }} {
    flex-direction: column-reverse;
  }
  {% endif %}

  .custom-media-text__media {
    width: 100%;
  }

  .custom-media-text__content {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .custom-media-text--{{ section.id }} {
      flex-direction: row;
      align-items: center;
      gap: 4rem; /* Un poco más de espacio en desktop */
    }

    .custom-media-text__media {
      width: {{ section.settings.media_width }}%;
    }

    .custom-media-text__content {
      width: {{ 100 | minus: section.settings.media_width }}%;
    }
  }

  .custom-media-text__media img,
  .custom-media-text__media video,
  .custom-media-text__media svg {
    width: 100%;
    height: auto;
    display: block;
    max-width: 100%;
    border-radius: 12px;
  }

  .custom-media-text__media svg {
    background: #f4f4f4;
  }

  .custom-media-text__text,
  .custom-media-text__text p,
  .custom-media-text__text span,
  .custom-media-text__text a,
  .custom-media-text__text li {
    font-family: {{ section.settings.content_font.family | default: 'Inter' }}, sans-serif;
    color: {{ section.settings.text_color }};
  }

  .custom-media-text__text strong,
  .custom-media-text__text b {
    font-weight: bold;
    font-family: {{ content_font_bold.family | default: section.settings.content_font.family | default: 'Inter' }}, sans-serif;
  }
{%- endstyle -%}

<div class="custom-media-text section-{{ section.id }}-padding">
  <div class="page-width custom-media-text--{{ section.id }}">
    <div class="custom-media-text__media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="custom-media-text__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="custom-media-text__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MW - Custom Image/Video",
  "settings": [
    {
      "type": "font_picker",
      "id": "content_font",
      "label": "Content Font",
      "default": "inter_n4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Overrides image if provided"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Media width (Desktop)",
      "default": 35
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "normal",
          "label": "Media First"
        },
        {
          "value": "reversed",
          "label": "Text First (Reversed)"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MW - Custom Image/Video",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
