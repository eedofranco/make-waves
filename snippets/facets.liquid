{% comment %}
  Renders facets (filtering and sorting)

  Accepts:
  - results: {Object} Collection or Search object
  - enable_filtering: {Boolean} Show filtering when true
  - enable_sorting: {Boolean} Show sorting when true
  - filter_type: {String} Type of filter
  - paginate: {Object}
  - color_swatch_map: {String} (optional) Pre-built color swatch map from products

  Usage:
  {% render 'facets', results: collection, enable_filtering: true, enable_sorting: true, filter_type: 'vertical', paginate: paginate %}
{% endcomment %}

{{ 'component-show-more.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}

<style>
  .facets-container {
    margin: 0 !important;
    padding: 10px 0 !important;
    background-color: #f6f6f6;
    border-top: 1px solid #eaeaea;
    border-bottom: 1px solid #eaeaea;
    width: 100%;
    display: block !important;
  }
  
  aside#main-collection-filters {
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    width: 100% !important;
  }

  facet-filters-form,
  facet-filters-form.facets {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  .facets__form {
    display: flex !important;
    flex-direction: column;
    width: 100% !important; 
    max-width: 100% !important;
    padding: 0 !important;
  }

  .facets-top-bar {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    min-height: 40px !important;
  }

  .facets-top-bar__right {
    display: flex;
    align-items: center;
  }

  #FacetsWrapperDesktop.facets__wrapper {
    background: transparent;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 15px;
    width: auto;
  }

  /* Two-row responsive layout: mobile & tablet portrait only (max-width 989px) */
  @media screen and (max-width: 989px) {
    .facets-top-bar {
      flex-direction: column;
      align-items: stretch !important;
      justify-content: flex-start !important;
      gap: 10px !important;
    }

    .facets-top-bar__right {
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    #FacetsWrapperDesktop.facets__wrapper {
      width: 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #FacetsWrapperDesktop.facets__wrapper::-webkit-scrollbar {
      display: none;
      height: 0;
      width: 0;
    }

    #FacetsWrapperDesktop .facets__disclosure {
      flex: 0 0 auto;
    }
  }
  
  .active-facets {
    flex-basis: 100%;
    min-height: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    align-items: center;
    padding-top: 0.1px;
  }

  .active-facets:empty {
    padding-top: 0;
  }

  .active-facets > * {
    margin-top: 10px;
  }

  /* Active Facet Black Badge Styles */
  .active-facets__button {
    display: inline-flex !important;
    text-decoration: none !important;
    width: fit-content !important;
    max-width: 100%;
    margin: 0;
  }

  .active-facets__button-inner {
    background-color: #222 !important;
    color: #fff !important;
    border: none !important;
    border-radius: 40px !important;
    padding: 6px 12px 6px 16px !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    text-transform: none !important;
    box-shadow: none !important;
    height: auto !important;
    min-height: auto !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    width: fit-content !important;
  }

  .active-facets__button-inner:hover {
    background-color: #333 !important;
  }

  .active-facets__button-inner .svg-wrapper {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 12px !important;
    height: 12px !important;
  }
  
  .active-facets__button-inner svg {
    width: 100% !important;
    height: 100% !important;
    fill: none !important;
    stroke: #ffffff !important;
    stroke-width: 1.5px !important;
    display: block !important;
  }
  
  .active-facets__button-wrapper {
    display: flex !important;
    align-items: center !important;
    padding: 0 !important;
    margin: 10px 0 0 5px;
  }

  a.active-facets__button-remove,
  a.active-facets__button-remove span {
    font-size: 12px !important;
    color: #888 !important;
    text-decoration: none !important;
  }

  .active-facets__button-remove {
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1;
    display: flex;
    align-items: center;
  }

  .active-facets__button-remove:hover,
  .active-facets__button-remove:hover span {
    color: #555 !important;
    text-decoration: none;
  }
  
  #FacetsWrapperDesktop .facets__heading {
    background-color: #222;
    color: #fff !important;
    padding: 8px 24px;
    margin: 0;
    border: 1px solid #222;
    font-size: 1.2rem;
    font-weight: 400;
    font-family: var(--font-body-family) !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #FacetsWrapperDesktop .facets__disclosure {
    margin: 0 !important;
  }

  #FacetsWrapperDesktop .facets__summary {
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 40px;
    padding: 8px 18px !important;
    margin-bottom: 0;
    transition: border-color 0.2s ease;
  }

  #FacetsWrapperDesktop .facets__summary:hover {
    border-color: #999;
  }

  #FacetsWrapperDesktop .facets__summary > div {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  #FacetsWrapperDesktop .facets__summary .icon-caret {
    position: static;
    width: 10px;
    height: 10px;
    margin-left: 4px;
  }

  .facet-filters.sorting {
    padding-left: 0 !important;
    margin: 0;
    display: flex;
    align-items: center;
  }

  .facet-filters__field {
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 40px;
    padding: 6px 14px !important;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 !important;
  }

  .sort-details {
    position: relative;
    margin: 0 !important;
  }
  
  .sort-details summary {
    list-style: none;
    outline: none;
    margin-bottom: 0 !important;
  }
  
  .sort-details summary::-webkit-details-marker {
    display: none;
  }
  
  .sort-details summary > div {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: #000;
    font-weight: normal !important;
    font-family: var(--font-body-family) !important;
  }
  
  .sort-details summary .icon-caret {
    position: static;
    width: 8px;
    height: 8px;
  }
  
  .sort-details .sort-label {
    color: #888;
    white-space: nowrap;
  }

  .sort-display {
    right: 0 !important;
    left: auto !important;
    width: 28rem;
    max-height: 18rem !important;
  }

  .sort-option {
    padding: 0.6rem 1.6rem;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .sort-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .sort-option__label {
    display: block;
    cursor: pointer;
    font-size: 13px;
    font-weight: 400;
    color: #666;
    padding: 0;
  }

  .sort-option:hover .sort-option__label {
    color: #111;
  }

  .sort-option--selected .sort-option__label {
    color: #111;
  }

  .facet-filters__field:hover {
    border-color: #999;
  }

  .product-count {
    margin-right: 15px;
    margin-left: 0;
    display: flex;
    align-items: center;
    line-height: 1;
    margin-top: 0;
    margin-bottom: 0;
    height: 40px; /* Exact height of the pill for perfect alignment */
  }
  
  .product-count * {
    font-family: var(--font-body-family) !important;
    font-weight: normal !important;
  }
  
  .product-count__text,
  #ProductCountDesktop {
    font-size: 13px !important;
    color: #888 !important;
    margin: 0 !important;
    line-height: 1 !important;
    display: flex;
    align-items: center;
    height: 40px;
  }
  
  .facets-container {
    padding-top: 0;
  }

  .facets__form {
    margin-bottom: 0;
  }

  .facets-container > * + * {
    margin-top: 0;
  }

  /* Mobile facets: single bar with filter button + badge, count on the right (desktop filter bar hidden) */
  @media screen and (max-width: 749px) {
    .facets-container {
      display: flex !important;
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      padding-left: 12px !important;
      padding-right: 12px !important;
    }

    /* Show only the desktop sort (single sort control) on mobile */
    .facets-container > .page-width {
      display: flex !important;
      flex: 0 0 auto;
      order: 3;
      align-items: center;
      width: auto !important;
      max-width: none !important;
      margin: 0 0 0 auto !important;
      padding: 0 !important;
    }

    .facets-container > .page-width facet-filters-form {
      display: flex !important;
      width: auto !important;
      max-width: none !important;
    }

    .facets-container > .page-width .facets-top-bar {
      display: flex !important;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: flex-end !important;
      width: auto !important;
      gap: 0 !important;
      min-height: 0 !important;
    }

    .facets-container > .page-width .sort-display {
      width: min(28rem, calc(100vw - 3rem)) !important;
    }

    /* Hide desktop filters and pills on mobile (keep count + sort in facets-top-bar__right) */
    .facets-container > .page-width #FacetsWrapperDesktop,
    .facets-container > .page-width .active-facets-desktop {
      display: none !important;
    }

    /* Row 1: black filter button + reset */
    .facets-container > .mobile-facets__wrapper {
      order: 1;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 0 0 auto;
    }

    /* Remove the Reset (clear all) link from the mobile bar */
    .facets-container > .active-facets-mobile.mw-mobile-reset-bar {
      display: none !important;
    }

    .facets-container > .page-width .facets-top-bar__right {
      flex-wrap: nowrap !important;
      white-space: nowrap !important;
    }

    /* Product count now lives inside facets-top-bar__right (with sort) */
    .facets-container > .product-count.medium-hide.large-up-hide {
      display: none !important;
    }

    /* Black filter button with white icon */
    .mobile-facets__open.mw-filter-button {
      background-color: #000 !important;
      color: #fff !important;
      border-radius: 0 !important;
      padding: 10px 16px !important;
      width: auto !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 8px !important;
      border: none !important;
      line-height: 1;
    }

    .mobile-facets__open.mw-filter-button .svg-wrapper {
      width: 15px !important;
      height: 15px !important;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-facets__open.mw-filter-button svg {
      stroke: #fff !important;
    }

    .mobile-facets__open.mw-filter-button line,
    .mobile-facets__open.mw-filter-button circle {
      stroke: #fff !important;
    }

    .mobile-facets__open.mw-filter-button .mobile-facets__open-label {
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .mobile-facets__open.mw-filter-button > * + * {
      margin-left: 0 !important;
    }

    /* Applied filters badge */
    .mw-facet-badge {
      min-width: 18px;
      height: 18px;
      border-radius: 50%;
      background-color: #fff !important;
      color: #000 !important;
      font-size: 11px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      line-height: 1;
    }

    /* Hide drawer header count duplicate: bar count hidden while drawer open */
    .facets-container:has(.mobile-facets__wrapper details[open]) > .page-width .facets-top-bar__right .product-count {
      visibility: hidden;
    }

    /* Drawer above sticky header */
    .facets-container .mobile-facets {
      z-index: 10001 !important;
    }

    .facets-container .disclosure-has-popup[open] > summary::before {
      z-index: 10000;
    }

    /* Drawer: straight edges + slides in from the left */
    .mobile-facets__inner,
    .mobile-facets__submenu {
      border-radius: 0 !important;
    }

    .mobile-facets__inner {
      margin-right: auto !important;
      margin-left: 0 !important;
    }

    .js .disclosure-has-popup:not(.menu-opening) .mobile-facets__inner {
      transform: translateX(-105vw) !important;
    }

    /* Apply buttons straight */
    .mobile-facets__footer .button,
    .mobile-facets__footer .button::after,
    .mobile-facets__footer .button::before {
      border-radius: 0 !important;
    }

    /* Apply button always pushed to the far right of the drawer footer */
    .mobile-facets__footer {
      justify-content: flex-end !important;
    }

    .mobile-facets__footer > * {
      width: auto !important;
    }

    .mobile-facets__footer .mobile-facets__clear-wrapper {
      margin-right: auto !important;
    }

    .mobile-facets__clear.disabled {
      color: #bbb;
    }

    /* Neutralize the header white overlay when the facets drawer opens */
    body:has(.mobile-facets__wrapper details[open])::before {
      display: none !important;
    }

    /* Drawer header: title + count + close X */
    .mobile-facets__header {
      display: flex !important;
      align-items: center !important;
      text-align: left !important;
      padding: 1.2rem 2rem !important;
    }

    .mobile-facets__heading {
      font-size: 1.4rem !important;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .mobile-facets__count {
      flex-grow: 0 !important;
      margin-left: 8px !important;
      font-size: 1.2rem !important;
    }

    .mw-drawer-close {
      margin-left: auto;
      background: none;
      border: none;
      cursor: pointer;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
    }

    .mw-drawer-close .svg-wrapper {
      width: 16px;
      height: 16px;
      display: flex;
    }

    /* Applied filters detail at top of drawer */
    .mw-drawer-active-facets {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 1.2rem 2rem 0.4rem;
      flex: 0 0 auto;
    }

    .mw-drawer-active-facets:empty {
      display: none;
    }

    .mw-drawer-active-facets .active-facets__button {
      margin: 0;
    }

    .mw-drawer-active-facets .active-facets__button-inner {
      font-size: 12px !important;
    }
  }

</style>

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  if results.handle == 'all' and results.sort_by == blank
    assign sort_by = 'best-selling'
  endif
  assign total_active_values = 0
  assign default_presentation = 'text'
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif

  assign mw_total_variants = 0
  assign mw_active_color_values = ""
  assign mw_active_other_values = ""
  for filter in results.filters
    assign f_label = filter.label | downcase
    if f_label contains 'color' or f_label contains 'colour' or f_label contains 'tinte'
      for value in filter.active_values
        assign mw_active_color_values = mw_active_color_values | append: value.label | downcase | append: '|||'
      endfor
    else
      for value in filter.active_values
        assign mw_active_other_values = mw_active_other_values | append: value.label | downcase | append: '|||'
      endfor
    endif
  endfor

  for mw_product in results.products
    assign mw_color_option_index = nil
    for option in mw_product.options_with_values
      assign downcased_name = option.name | downcase
      if downcased_name contains 'color' or downcased_name contains 'colour' or downcased_name contains 'tinte'
        assign mw_color_option_index = forloop.index0
        break
      endif
    endfor

    if mw_color_option_index != nil
      assign mw_rendered_colors = ""
      for variant in mw_product.variants
        assign mw_variant_color = variant.options[mw_color_option_index]
        assign mw_color_slug = mw_variant_color | downcase | replace: ' ', '-' | append: '|'
        assign mw_variant_color_downcased = mw_variant_color | downcase | append: '|||'

        assign mw_color_matches = true
        if mw_active_color_values != blank
          unless mw_active_color_values contains mw_variant_color_downcased
            assign mw_color_matches = false
          endunless
        endif

        if mw_color_matches
          assign mw_other_match = true
          if mw_active_other_values != blank
            assign mw_other_match = false
            for v in mw_product.variants
              if v.options[mw_color_option_index] == mw_variant_color
                for option_val in v.options
                  if forloop.index0 != mw_color_option_index
                    assign opt_downcased = option_val | downcase | append: '|||'
                    if mw_active_other_values contains opt_downcased
                      assign mw_other_match = true
                    endif
                  endif
                endfor
              endif
            endfor
          endif

          if mw_other_match
            unless mw_rendered_colors contains mw_color_slug
              assign mw_rendered_colors = mw_rendered_colors | append: mw_color_slug
              assign mw_total_variants = mw_total_variants | plus: 1
            endunless
          endif
        endif
      endfor
    else
      assign mw_total_variants = mw_total_variants | plus: 1
    endif
  endfor
-%}

<div class="facets-container{% if filter_type == 'drawer' %} facets-container-drawer{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
  <div class="page-width">
    {%- if filter_type == 'vertical' or filter_type == 'horizontal' -%}
      <facet-filters-form class="facets small-hide">
      <form
        id="FacetFiltersForm"
        class="{% if filter_type == 'horizontal' %}facets__form{% else %}facets__form-vertical{% endif %}"
      >
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="options[prefix]" type="hidden" value="last">
        {%- endif -%}

        <div class="facets-top-bar">
          {% if enable_filtering %}
            {% comment %} Heading is the first tabbable element on filter type horizontal {% endcomment %}
          <div
            id="FacetsWrapperDesktop"
            {% if filter_type == 'horizontal' %}
              class="facets__wrapper"
            {% endif %}
          >
            {%- if filter_type == 'horizontal' and results.filters != empty -%}
              <h2 class="facets__heading caption-large text-body" id="verticalTitle" tabindex="-1">
                {{ 'products.facets.filter_by_label' | t }}
              </h2>
            {%- endif -%}
            {% comment %} Pills are right below the title for filter type vertical {% endcomment %}
            {%- if filter_type == 'vertical' -%}
              <div class="active-facets active-facets-desktop">
                <div class="active-facets-vertical-filter">
                  {%- unless results.filters == empty -%}
                    <h2
                      class="facets__heading facets__heading--vertical caption-large text-body"
                      id="verticalTitle"
                      tabindex="-1"
                    >
                      {{ 'products.facets.filter_by_label' | t }}
                    </h2>
                  {%- endunless -%}
                  {%- if total_active_values > 0 -%}
                    <facet-remove class="active-facets__button-wrapper">
                      <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                        <span>{{ 'products.facets.clear_all' | t }}</span>
                      </a>
                    </facet-remove>
                  {%- endif -%}
                </div>
                {%- for filter in results.filters -%}
                  {%- for value in filter.active_values -%}
                    <facet-remove>
                      <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                        <span class="active-facets__button-inner">
                          {%- assign filter_label_downcase = filter.label | downcase -%}
                          {%- if filter_label_downcase == 'size' or filter_label_downcase == 'talla' -%}
                            {{ filter.label | escape }}: {{ value.label | escape }}
                          {%- else -%}
                            {{ value.label | escape }}
                          {%- endif -%}
                          <span class="svg-wrapper">
                            {{- 'icon-close-small.svg' | inline_asset_content -}}
                          </span>
                          <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                        </span>
                      </a>
                    </facet-remove>
                  {%- endfor -%}
                  {% if filter.type == 'price_range' %}
                    {% assign min = filter.min_value.value %}
                    {% assign max = filter.max_value.value %}
                    {%- if min != null or max != null -%}
                      <facet-remove>
                        <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                          <span class="active-facets__button-inner">
                            {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                            <span class="svg-wrapper">
                              {{- 'icon-close-small.svg' | inline_asset_content -}}
                            </span>
                            <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                          </span>
                        </a>
                      </facet-remove>
                    {%- endif -%}
                  {% endif %}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
            {% comment %} Filters for both horizontal and vertical filter {% endcomment %}
            {%- for filter in results.filters -%}
              {% liquid
                assign total_active_values = total_active_values | plus: filter.active_values.size
                assign presentation = filter.presentation | default: default_presentation
                assign filter_label_downcase = filter.label | downcase
                if presentation == 'text'
                  if filter_label_downcase contains 'color' or filter_label_downcase contains 'colour'
                    assign presentation = 'swatch'
                  endif
                endif

                if presentation == 'image'
                  assign show_more_number = 12
                  assign visual_layout_class = 'facets-layout facets-layout-grid facets-layout-grid--' | append: presentation
                elsif presentation == 'swatch'
                  assign show_more_number = 10
                  assign visual_layout_class = 'facets-layout facets-layout-grid facets-layout-grid--swatch'
                else
                  assign show_more_number = 10
                  assign visual_layout_class = 'facets-layout facets-layout-list facets-layout-list--' | append: presentation
                endif
              %}

              {% case filter.type %}
                {% when 'boolean', 'list' %}
                  <details
                    id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
                    class="{% if filter_type == 'horizontal' %}disclosure-has-popup facets__disclosure{% else %} facets__disclosure-vertical{% endif %} js-filter"
                    data-index="{{ forloop.index }}"
                    {% if filter_type == 'vertical' and forloop.index == 1 %}
                      open
                    {% endif %}
                  >
                    <summary
                      class="facets__summary caption-large focus-offset"
                      aria-label="{{ filter.label | escape }} ({{ 'products.facets.filters_selected.one' | t: count: filter.active_values.size }})"
                    >
                      <div>
                        <span class="facets__summary-label">
                          {{- filter.label | escape }}
                          {%- if filter_type == 'vertical' -%}
                            <span class="facets__selected{% if filter.active_values.size == 0 %} hidden{% endif %}">
                              ({{ filter.active_values.size }})</span
                            >
                          {%- endif -%}
                        </span>
                        {%- if filter_type == 'vertical' and filter.operator == 'AND' -%}
                          <span class="facets__and-helptext">
                            {{ 'products.facets.filter_and_operator_subtitle' | t }}
                          </span>
                        {%- endif -%}
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </div>
                    </summary>
                    <div
                      id="Facet-{{ forloop.index }}-{{ section.id }}"
                      class="parent-display {% if filter_type == 'horizontal' %}facets__display{% else %}facets__display-vertical{% endif %}"
                    >
                      {%- if filter_type != 'vertical' -%}
                        <div class="facets__header">
                          <div>
                            <span class="facets__selected">
                              {{- 'products.facets.filters_selected' | t: count: filter.active_values.size -}}
                            </span>
                            {%- if filter.operator == 'AND' -%}
                              <span class="facets__and-helptext">
                                {{ 'products.facets.filter_and_operator_subtitle' | t }}
                              </span>
                            {%- endif -%}
                          </div>
                          <facet-remove>
                            <a href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link">
                              {{ 'products.facets.reset' | t }}
                            </a>
                          </facet-remove>
                        </div>
                      {%- endif -%}
                      <fieldset class="facets-wrap parent-wrap {% if filter_type == 'vertical' %} facets-wrap-vertical{% endif %}">
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        {%- liquid
                          assign sorted_values = filter.values
                          # Keep the selected values grouped together when operator is AND
                          if filter.operator == 'AND'
                            assign active_filter_values = filter.values | where: 'active', true
                            assign inactive_filter_values = filter.values | where: 'active', false
                            assign sorted_values = active_filter_values | concat: inactive_filter_values
                          endif
                        -%}
                        <ul
                          class="{{ visual_layout_class }}{% if filter_type == 'vertical' %} facets__list--vertical{% else %} facets__list{% endif %} list-unstyled"
                          role="list"
                        >
                          {%- for value in sorted_values -%}
                            {% liquid
                              assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-' | append: forloop.index
                              assign is_disabled = false
                              if value.count == 0 and value.active == false
                                assign is_disabled = true
                              endif
                            %}
                            {%- capture label_class -%}
                            facets__label facet-checkbox{% if is_disabled %} disabled{% endif %}{% if value.active %} active{% endif %}
                            {%- endcapture -%}

                            {%- capture text_value -%}
                              <span class="facet-checkbox__text" aria-hidden="true">
                                <span class="facet-checkbox__text-label">{{- value.label | escape }}</span> ({{- value.count -}})
                              </span>
                              <span class="visually-hidden">
                                {{- value.label | escape }} (
                                {%- if value.count == 1 -%}
                                  {{- 'products.facets.product_count_simple.one' | t: count: value.count -}}
                                {%- else -%}
                                  {{- 'products.facets.product_count_simple.other' | t: count: value.count -}}
                                {%- endif -%}
                                )
                              </span>
                            {%- endcapture -%}

                            <li class="list-menu__item facets__item{% if forloop.index > show_more_number and filter_type == 'vertical' %} show-more-item hidden{% endif %}">
                              {%- if presentation == 'swatch' -%}
                                <div class="{{ label_class }}">
                                  <div class="swatch-input-wrapper">
                                    {%- if value.swatch.color or value.swatch.image -%}
                                      {% render 'swatch-input',
                                        id: input_id,
                                        type: 'checkbox',
                                        name: value.param_name,
                                        value: value.value,
                                        product_form_id: 'FacetFiltersForm',
                                        swatch: value.swatch,
                                        checked: value.active,
                                        disabled: is_disabled,
                                        tooltip_text: value.label
                                      %}
                                      {%- else -%}
                                      {%- liquid
                                        assign color_key = value.label | downcase | strip | replace: ' ', ''
                                        assign swatch_bg = '#d0d0d0'
                                        case color_key
                                          when 'sand' or 'makewavessand'
                                            assign swatch_bg = '#e2dcd0'
                                          when 'olive'
                                            assign swatch_bg = '#5b6251'
                                          when 'indigo' or 'craftstoriesindigo'
                                            assign swatch_bg = '#2c3539'
                                          when 'navy'
                                            assign swatch_bg = '#1d2731'
                                          when 'slate'
                                            assign swatch_bg = '#5c6b73'
                                          when 'black'
                                            assign swatch_bg = '#111111'
                                          when 'white'
                                            assign swatch_bg = '#ffffff'
                                          when 'cream'
                                            assign swatch_bg = '#f5f5dc'
                                          when 'green' or 'darkgreen'
                                            assign swatch_bg = '#2d4a3e'
                                          when 'teal' or 'darkteal'
                                            assign swatch_bg = '#2a4d4f'
                                          when 'grey' or 'gray'
                                            assign swatch_bg = '#808080'
                                          when 'red' or 'rojo'
                                            assign swatch_bg = '#e74c3c'
                                          when 'blue' or 'azul'
                                            assign swatch_bg = '#3498db'
                                          when 'yellow' or 'amarillo'
                                            assign swatch_bg = '#f1c40f'
                                          when 'pink' or 'rosa'
                                            assign swatch_bg = '#e91e8a'
                                          when 'purple' or 'morado'
                                            assign swatch_bg = '#9b59b6'
                                          when 'brown' or 'marron' or 'marrón'
                                            assign swatch_bg = '#8b4513'
                                          when 'beige'
                                            assign swatch_bg = '#d4c8a0'
                                          when 'orange' or 'naranja'
                                            assign swatch_bg = '#e67e22'
                                        endcase
                                        if color_swatch_map != blank
                                          assign map_entries = color_swatch_map | split: '___'
                                          for entry in map_entries
                                            assign parts = entry | split: '||'
                                            if parts[0] == color_key
                                              assign swatch_bg = parts[1]
                                            endif
                                          endfor
                                        endif
                                      -%}
                                      <input type="checkbox" id="{{ input_id }}" name="{{ value.param_name }}" value="{{ value.value }}" form="FacetFiltersForm" class="swatch-input__input"{% if value.active %} checked{% endif %}{% if is_disabled %} disabled{% endif %}>
                                      <label for="{{ input_id }}" class="swatch-input__label">
                                        <span class="swatch" style="--swatch--background: {{ swatch_bg }};"></span>
                                        <span class="swatch-tooltip">{{ value.label | escape }}</span>
                                      </label>
                                    {%- endif -%}
                                  </div>
                                </div>
                              {%- else -%}
                                <label for="{{ input_id }}" class="{{ label_class }}">
                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    id="{{ input_id }}"
                                    {% if value.active %}
                                      checked
                                    {% endif %}
                                    {% if is_disabled %}
                                      disabled
                                    {% endif %}
                                  >

                                  {%- if presentation == 'image' -%}
                                    <div class="facets__image-wrapper">
                                      {%- if value.image -%}
                                        {{
                                          value.image
                                          | image_url: width: 300
                                          | image_tag: class: 'facets__image', alt: value.alt
                                        }}
                                      {%- endif -%}
                                    </div>
                                  {%- else -%}
                                    {{- 'square.svg' | inline_asset_content -}}

                                    <div class="svg-wrapper">
                                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                                    </div>
                                  {%- endif -%}

                                  {{ text_value }}
                                </label>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </fieldset>
                      {%- if filter.values.size > show_more_number and filter_type == 'vertical' -%}
                        <show-more-button>
                          <button
                            class="button-show-more link underlined-link"
                            id="Show-More-{{ forloop.index }}-{{ section.id }}"
                            type="button"
                          >
                            <span class="label-show-more label-text"
                              ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t -}}
                            </span>
                            <span class="label-show-less label-text hidden"
                              ><span aria-hidden="true">- </span>{{ 'products.facets.show_less' | t -}}
                            </span>
                          </button>
                        </show-more-button>
                      {%- endif %}
                    </div>
                  </details>
                {% when 'price_range' %}
                  <details
                    id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
                    class="{% if filter_type == 'horizontal' %}disclosure-has-popup facets__disclosure{% else %} facets__disclosure-vertical{% endif %} js-filter"
                    data-index="{{ forloop.index }}"
                    {% if filter_type == 'vertical' and forloop.index == 1 %}
                      open
                    {% endif %}
                  >
                    <summary class="facets__summary caption-large focus-offset">
                      <div>
                        <span>{{ filter.label | escape }}</span>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </div>
                    </summary>
                    <div
                      id="Facet-{{ forloop.index }}-{{ section.id }}"
                      class="{% if filter_type == 'horizontal' %}facets__display{% else %}facets__display-vertical{% endif %}"
                    >
                      <div class="{% if filter_type == 'horizontal' %}facets__header{% else %}facets__header-vertical{% endif %}">
                        {%- assign max_price_amount = filter.range_max | money | strip_html | escape -%}
                        <span class="facets__selected">
                          {{- 'products.facets.max_price' | t: price: max_price_amount -}}
                        </span>
                        {%- if filter_type != 'vertical' -%}
                          <facet-remove>
                            <a href="{{ filter.url_to_remove }}" class="facets__reset link underlined-link">
                              {{ 'products.facets.reset' | t }}
                            </a>
                          </facet-remove>
                        {%- endif -%}
                      </div>
                      <price-range class="facets__price">
                        {% render 'price-facet', filter: filter, id_prefix: 'Filter-', filter_type: filter_type %}
                      </price-range>
                    </div>
                  </details>
              {% endcase %}
            {%- endfor -%}
          </div>
          {% comment %} Pills after filtes on filter type horizontal {% endcomment %}
        {% endif %}

        {% if results.current_vendor or results.current_type %}
          <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
        {% endif %}

        {%- if filter_type == 'horizontal' -%}
          <div class="facets-top-bar__right">
            <div class="product-count light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if results.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
                  {%- else -%}
                    {{ 'products.facets.product_count_simple' | t: count: mw_total_variants }}
                  {%- endif -%}
                </span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
            
            {% comment %} Sorting is the last element now {% endcomment %}
            {%- if enable_sorting -%}
              <div class="facet-filters sorting caption">
                <div class="facet-filters__field custom-sort-field">
                  {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
                  {%- if results.handle == 'all' and results.sort_by == blank -%}
                    {%- assign sort_by = 'best-selling' -%}
                  {%- endif -%}
                  {%- assign current_sort_name = '' -%}
                  {%- for option in results.sort_options -%}
                    {% if option.value == sort_by %}
                      {%- if option.value == 'best-selling' -%}
                        {%- assign current_sort_name = 'Best sellers' -%}
                      {%- else -%}
                        {%- assign current_sort_name = option.name -%}
                      {%- endif -%}
                    {% endif %}
                  {%- endfor -%}
                  <details id="Details-SortBy-{{ section.id }}" class="disclosure-has-popup facets__disclosure js-filter sort-details">
                    <summary class="facets__summary caption-large focus-offset">
                      <div>
                        <span class="sort-label">SORT:</span>
                        <span class="current-sort-name">{{ current_sort_name | escape }}</span>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </div>
                    </summary>
                    <div id="Facet-SortBy-{{ section.id }}" class="facets__display sort-display">
                      <ul class="facets__list list-unstyled" role="list">
                        {%- for option in results.sort_options -%}
                          <li class="list-menu__item facets__item sort-option{% if option.value == sort_by %} sort-option--selected{% endif %}" data-value="{{ option.value | escape }}">
                            <label for="SortBy-{{ forloop.index }}" class="sort-option__label">
                              <input type="radio"
                                name="sort_by"
                                value="{{ option.value | escape }}"
                                id="SortBy-{{ forloop.index }}"
                                {% if option.value == sort_by %}checked{% endif %}
                              >
                              <span>
                                {%- if option.value == 'best-selling' -%}
                                  Best sellers
                                {%- else -%}
                                  {{ option.name | escape }}
                                {%- endif -%}
                              </span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </details>
                </div>
              </div>
            {%- endif -%}
          </div> <!-- End facets-top-bar__right -->
        {%- endif -%}
        </div> <!-- End facets-top-bar -->

        {%- if filter_type == 'horizontal' -%}
          <div class="active-facets active-facets-desktop">
            {%- for filter in results.filters -%}
              {%- for value in filter.active_values -%}
                <facet-remove>
                  <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                    <span class="active-facets__button-inner">
                      {%- assign filter_label_downcase = filter.label | downcase -%}
                      {%- if filter_label_downcase == 'size' or filter_label_downcase == 'talla' -%}
                        {{ filter.label | escape }}: {{ value.label | escape }}
                      {%- else -%}
                        {{ value.label | escape }}
                      {%- endif -%}
                      <span class="svg-wrapper">
                        {{- 'icon-close-small.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                    </span>
                  </a>
                </facet-remove>
              {%- endfor -%}
              {% if filter.type == 'price_range' %}
                {% assign min = filter.min_value.value %}
                {% assign max = filter.max_value.value %}
                {%- if min != null or max != null -%}
                  <facet-remove>
                    <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                      <span class="active-facets__button-inner">
                        {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                        <span class="svg-wrapper">
                          {{- 'icon-close-small.svg' | inline_asset_content -}}
                        </span>
                        <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                      </span>
                    </a>
                  </facet-remove>
                {%- endif -%}
              {% endif %}
            {%- endfor -%}
            {%- if total_active_values > 0 -%}
              <facet-remove class="active-facets__button-wrapper">
                <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                  <span>{{ 'products.facets.clear_all' | t }}</span>
                </a>
              </facet-remove>
            {%- endif -%}
          </div>
        {%- endif -%}

      </form>
      </facet-filters-form>
    {%- endif -%}
  </div>
  {% comment %}  Drawer and mobile filter {% endcomment %}
  <menu-drawer
    class="mobile-facets__wrapper{% if filter_type == 'horizontal' or filter_type == 'vertical' %} medium-hide large-up-hide{% endif %}"
    data-breakpoint="mobile"
  >
    <details class="mobile-facets__disclosure disclosure-has-popup">
      <summary class="mobile-facets__open-wrapper focus-offset">
        <span class="mobile-facets__open mw-filter-button{% if filter_type == 'drawer' and enable_filtering == false %} medium-hide large-up-hide{% endif %}">
          <span class="svg-wrapper">
            {{- 'icon-filter.svg' | inline_asset_content -}}
          </span>
          <span class="mobile-facets__open-label button-label">
            {{ 'products.facets.filter_button' | t }}
          </span>
          {%- if total_active_values > 0 -%}
            <span class="mw-facet-badge">{{ total_active_values }}</span>
          {%- endif -%}
        </span>
      </summary>
      <facet-filters-form>
        <form id="FacetFiltersFormMobile" class="mobile-facets">
          <div class="mobile-facets__inner gradient">
            <div class="mobile-facets__header">
              <div class="mobile-facets__header-inner">
                <h2 class="mobile-facets__heading">
                  {{ 'products.facets.filter_button' | t }}
                </h2>
                <p class="mobile-facets__count">
                  {%- if results.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
                  {%- else -%}
                    {{ 'products.facets.product_count_simple' | t: count: mw_total_variants }}
                  {%- endif -%}
                </p>
              </div>
              <button
                type="button"
                class="mw-drawer-close"
                aria-label="Close"
                onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
              >
                {{- 'icon-close.svg' | inline_asset_content -}}
              </button>
            </div>
            <div
              id="FacetsWrapperMobile"
              class="mobile-facets__main has-submenu gradient"
            >
              <div class="mw-drawer-active-facets active-facets">
                {%- if total_active_values > 0 -%}
                  {%- for filter in results.filters -%}
                    {%- for value in filter.active_values -%}
                      <facet-remove>
                        <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                          <span class="active-facets__button-inner">
                            {%- assign filter_label_downcase = filter.label | downcase -%}
                            {%- if filter_label_downcase == 'size' or filter_label_downcase == 'talla' -%}
                              {{ filter.label | escape }}: {{ value.label | escape }}
                            {%- else -%}
                              {{ value.label | escape }}
                            {%- endif -%}
                            <span class="svg-wrapper">
                              {{- 'icon-close-small.svg' | inline_asset_content -}}
                            </span>
                            <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                          </span>
                        </a>
                      </facet-remove>
                    {%- endfor -%}
                    {%- if filter.type == 'price_range' -%}
                      {% assign min = filter.min_value.value %}
                      {% assign max = filter.max_value.value %}
                      {%- if min != null or max != null -%}
                        <facet-remove>
                          <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                            <span class="active-facets__button-inner">
                              {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                              <span class="svg-wrapper">
                                {{- 'icon-close-small.svg' | inline_asset_content -}}
                              </span>
                              <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                            </span>
                          </a>
                        </facet-remove>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>
              {%- if enable_filtering -%}
                {%- for filter in results.filters -%}
                  {% liquid
                    assign presentation = filter.presentation | default: default_presentation
                    assign filter_label_downcase_m = filter.label | downcase
                    if presentation == 'text'
                      if filter_label_downcase_m contains 'color' or filter_label_downcase_m contains 'colour'
                        assign presentation = 'swatch'
                      endif
                    endif
                    if presentation == 'image'
                      assign visual_layout_class = 'facets-layout facets-layout-grid facets-layout-grid--' | append: presentation
                    elsif presentation == 'swatch'
                      assign visual_layout_class = 'facets-layout facets-layout-grid facets-layout-grid--swatch'
                    else
                      assign visual_layout_class = 'facets-layout facets-layout-list facets-layout-list--' | append: presentation
                    endif
                  %}

                  {% case filter.type %}
                    {% when 'boolean', 'list' %}
                      <details
                        id="Details-Mobile-{{ filter.param_name | escape }}-{{ section.id }}"
                        class="mobile-facets__details js-filter"
                        data-index="mobile-{{ forloop.index }}"
                      >
                        <summary class="mobile-facets__summary focus-inset">
                          <div>
                            <span>{{ filter.label | escape }}</span>
                            <span class="mobile-facets__arrow">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                          </div>
                        </summary>
                        <div
                          id="FacetMobile-{{ forloop.index }}-{{ section.id }}"
                          class="mobile-facets__submenu gradient"
                        >
                          <button
                            class="mobile-facets__close-button link link--text focus-inset"
                            aria-expanded="true"
                            type="button"
                          >
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                            <span>{{ filter.label | escape }}</span>
                            {%- if filter.operator == 'AND' -%}
                              <span class="facets__and-helptext">
                                {{ 'products.facets.filter_and_operator_subtitle' | t }}
                              </span>
                            {%- endif -%}
                          </button>
                          <ul class="{{ visual_layout_class }} mobile-facets__list list-unstyled" role="list">
                            {%- liquid
                              assign sorted_values = filter.values
                              # Keep the selected values grouped together when operator is AND
                              if filter.operator == 'AND'
                                assign active_filter_values = filter.values | where: 'active', true
                                assign inactive_filter_values = filter.values | where: 'active', false
                                assign sorted_values = active_filter_values | concat: inactive_filter_values
                              endif
                            -%}
                            {%- for value in sorted_values -%}
                              {% liquid
                                assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-mobile-' | append: forloop.index
                                assign is_disabled = false
                                if value.count == 0 and value.active == false
                                  assign is_disabled = true
                                endif
                              %}

                              {%- capture label_class -%}
                              facets__label mobile-facets__label{% if is_disabled %} disabled{% endif %}{% if value.active %} active{% endif %}
                              {%- endcapture -%}

                              {%- capture text_value -%}
                                <span class="facet-checkbox__text" aria-hidden="true">
                                  <span class="facet-checkbox__text-label">{{- value.label | escape }}</span> ({{- value.count -}})
                                </span>
                                <span class="visually-hidden">
                                  {{- value.label | escape }} (
                                  {%- if value.count == '1' -%}
                                    {{- 'products.facets.product_count_simple.one' | t: count: value.count -}}
                                  {%- else -%}
                                    {{- 'products.facets.product_count_simple.other' | t: count: value.count -}}
                                  {%- endif -%}
                                  )
                                </span>
                              {%- endcapture -%}

                              <li class="mobile-facets__item list-menu__item">
                                {% if presentation == 'swatch' %}
                                  <div class="{{ label_class }}">
                                    <div class="swatch-input-wrapper">
                                      {%- if value.swatch.color or value.swatch.image -%}
                                        {% render 'swatch-input',
                                          id: input_id,
                                          type: 'checkbox',
                                          name: value.param_name,
                                          value: value.value,
                                          product_form_id: 'FacetFiltersFormMobile',
                                          swatch: value.swatch,
                                          checked: value.active,
                                          disabled: is_disabled,
                                          tooltip_text: value.label
                                        %}
                                        {%- else -%}
                                        {%- liquid
                                          assign color_key = value.label | downcase | strip | replace: ' ', ''
                                          assign swatch_bg = '#d0d0d0'
                                          case color_key
                                            when 'sand' or 'makewavessand'
                                              assign swatch_bg = '#e2dcd0'
                                            when 'olive'
                                              assign swatch_bg = '#5b6251'
                                            when 'indigo' or 'craftstoriesindigo'
                                              assign swatch_bg = '#2c3539'
                                            when 'navy'
                                              assign swatch_bg = '#1d2731'
                                            when 'slate'
                                              assign swatch_bg = '#5c6b73'
                                            when 'black'
                                              assign swatch_bg = '#111111'
                                            when 'white'
                                              assign swatch_bg = '#ffffff'
                                            when 'cream'
                                              assign swatch_bg = '#f5f5dc'
                                            when 'green' or 'darkgreen'
                                              assign swatch_bg = '#2d4a3e'
                                            when 'teal' or 'darkteal'
                                              assign swatch_bg = '#2a4d4f'
                                            when 'grey' or 'gray'
                                              assign swatch_bg = '#808080'
                                            when 'red' or 'rojo'
                                              assign swatch_bg = '#e74c3c'
                                            when 'blue' or 'azul'
                                              assign swatch_bg = '#3498db'
                                            when 'yellow' or 'amarillo'
                                              assign swatch_bg = '#f1c40f'
                                            when 'pink' or 'rosa'
                                              assign swatch_bg = '#e91e8a'
                                            when 'purple' or 'morado'
                                              assign swatch_bg = '#9b59b6'
                                            when 'brown' or 'marron' or 'marrón'
                                              assign swatch_bg = '#8b4513'
                                            when 'beige'
                                              assign swatch_bg = '#d4c8a0'
                                            when 'orange' or 'naranja'
                                              assign swatch_bg = '#e67e22'
                                          endcase
                                          if color_swatch_map != blank
                                            assign map_entries = color_swatch_map | split: '___'
                                            for entry in map_entries
                                              assign parts = entry | split: '||'
                                              if parts[0] == color_key
                                                assign swatch_bg = parts[1]
                                              endif
                                            endfor
                                          endif
                                        -%}
                                        <input type="checkbox" id="{{ input_id }}" name="{{ value.param_name }}" value="{{ value.value }}" form="FacetFiltersFormMobile" class="swatch-input__input"{% if value.active %} checked{% endif %}{% if is_disabled %} disabled{% endif %}>
                                        <label for="{{ input_id }}" class="swatch-input__label">
                                          <span class="swatch" style="--swatch--background: {{ swatch_bg }};"></span>
                                          <span class="swatch-tooltip">{{ value.label | escape }}</span>
                                        </label>
                                      {%- endif -%}
                                    </div>
                                  </div>
                                {% else %}
                                  <label for="{{ input_id }}" class="{{ label_class }}">
                                    <input
                                      class="mobile-facets__checkbox"
                                      type="checkbox"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      id="{{ input_id }}"
                                      {% if value.active %}
                                        checked
                                      {% endif %}
                                      {% if is_disabled %}
                                        disabled
                                      {% endif %}
                                    >

                                    {%- if presentation == 'image' -%}
                                      <div class="facets__image-wrapper">
                                        {%- if value.image -%}
                                          {{
                                            value.image
                                            | image_url: width: 300
                                            | image_tag: class: 'facets__image', alt: value.alt
                                          }}
                                        {%- endif -%}
                                      </div>
                                    {%- else -%}
                                      <span class="mobile-facets__highlight"></span>
                                      {{- 'square.svg' | inline_asset_content -}}
                                      {{- 'icon-checkmark.svg' | inline_asset_content -}}
                                    {%- endif %}

                                    {{ text_value }}
                                  </label>
                                {% endif %}
                              </li>
                            {%- endfor -%}
                          </ul>

                          <div class="mobile-facets__footer gradient">
                            <facet-remove class="mobile-facets__clear-wrapper">
                              <a href="{{ filter.url_to_remove }}" class="mobile-facets__clear underlined-link">
                                {{- 'products.facets.clear' | t -}}
                              </a>
                            </facet-remove>
                            <button
                              type="button"
                              class="button button--primary"
                              onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
                            >
                              {{ 'products.facets.apply' | t }}
                            </button>
                          </div>
                        </div>
                      </details>
                    {% when 'price_range' %}
                      <details
                        id="Details-Mobile-{{ filter.param_name | escape }}-{{ section.id }}"
                        class="mobile-facets__details js-filter"
                        data-index="mobile-{{ forloop.index }}"
                      >
                        <summary class="mobile-facets__summary focus-inset">
                          <div>
                            <span>{{ filter.label | escape }}</span>
                            <span class="mobile-facets__arrow">
                              {{- 'icon-arrow.svg' | inline_asset_content -}}
                            </span>
                          </div>
                        </summary>
                        <div
                          id="FacetMobile-{{ forloop.index }}-{{ section.id }}"
                          class="mobile-facets__submenu gradient"
                        >
                          <button
                            class="mobile-facets__close-button link link--text focus-inset"
                            aria-expanded="true"
                            type="button"
                          >
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                            {{ filter.label | escape }}
                          </button>

                          {%- assign max_price_amount = filter.range_max | money | strip_html | escape -%}
                          <p class="mobile-facets__info">
                            {{ 'products.facets.max_price' | t: price: max_price_amount }}
                          </p>

                          <price-range class="facets__price">
                            {% render 'price-facet', filter: filter, id_prefix: 'Mobile-Filter-' %}
                          </price-range>
                          <div class="mobile-facets__footer">
                            <facet-remove class="mobile-facets__clear-wrapper">
                              <a href="{{ filter.url_to_remove }}" class="mobile-facets__clear underlined-link">
                                {{- 'products.facets.clear' | t -}}
                              </a>
                            </facet-remove>
                            <button
                              type="button"
                              class="button button--primary"
                              onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
                            >
                              {{ 'products.facets.apply' | t }}
                            </button>
                          </div>
                        </div>
                      </details>
                  {% endcase %}
                {%- endfor -%}
              {%- endif -%}

              <div class="mobile-facets__footer">
                <facet-remove class="mobile-facets__clear-wrapper">
                  <a
                    href="{{ results_url }}"
                    class="mobile-facets__clear underlined-link{% if total_active_values == 0 %} disabled{% endif %}"
                    {% if total_active_values == 0 %}
                      aria-disabled="true"
                      tabindex="-1"
                    {% endif %}
                  >
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                </facet-remove>
                <button
                  type="button"
                  class="button button--primary"
                  onclick="this.closest('.mobile-facets__wrapper').querySelector('summary').click()"
                >
                  {{ 'products.facets.apply' | t }}
                </button>
              </div>
            </div>

            {% if results.current_vendor or results.current_type %}
              <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
            {% endif %}

            {%- if results.terms -%}
              <input type="hidden" name="q" value="{{ results.terms | escape }}">
              <input name="options[prefix]" type="hidden" value="last">
            {%- endif -%}
          </div>
        </form>
      </facet-filters-form>
    </details>
  </menu-drawer>

  <div class="active-facets active-facets-mobile mw-mobile-reset-bar medium-hide large-up-hide">
    {%- if total_active_values > 0 -%}
      <facet-remove class="active-facets__button-wrapper">
        <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
          <span>{{ 'products.facets.clear_all' | t }}</span>
        </a>
      </facet-remove>
    {%- endif -%}
  </div>
  {% comment %} Sort, product count and filter pills at the end when filter is type of Drawer for the correct tabbing order {% endcomment %}
  {%- if enable_sorting and filter_type == 'drawer' -%}
    <facet-filters-form class="facets small-hide">
      <form id="FacetSortDrawerForm" class="facets__form">
        <div class="facet-filters sorting caption small-hide">
          <div class="facet-filters__field">
            <h2 class="facet-filters__label caption-large text-body">
              <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
            </h2>
            <div class="select">
              {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
              <select
                name="sort_by"
                class="facet-filters__sort select__select caption-large"
                id="SortBy"
                aria-describedby="a11y-refresh-page-message"
              >
                {%- for option in results.sort_options -%}
                  <option
                    value="{{ option.value | escape }}"
                    {% if option.value == sort_by %}
                      selected="selected"
                    {% endif %}
                  >
                    {{ option.name | escape }}
                  </option>
                {%- endfor -%}
              </select>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </div>
          </div>
        </div>

        {% if results.current_vendor or results.current_type %}
          <input type="hidden" name="q" value="{{ results.current_vendor }}{{ results.current_type }}">
        {% endif %}

        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="options[prefix]" type="hidden" value="last">
        {%- endif -%}
      </form>
    </facet-filters-form>
  {%- endif -%}
  <div
    class="product-count light{% if filter_type == 'vertical' or filter_type == 'horizontal' %} medium-hide large-up-hide{% endif %}"
    role="status"
  >
    <h2 class="product-count__text text-body">
      <span id="ProductCount">
        {%- if results.results_count -%}
          {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
        {%- else -%}
          {{ 'products.facets.product_count_simple' | t: count: mw_total_variants }}
        {%- endif -%}
      </span>
    </h2>
    {%- render 'loading-spinner' -%}
  </div>
  {%- if filter_type == 'drawer' -%}
    <facet-filters-form class="facets facets-pill small-hide">
      <form id="FacetFiltersPillsForm" class="facets__form">
        <div class="active-facets active-facets-desktop">
          {%- for filter in results.filters -%}
            {%- for value in filter.active_values -%}
              <facet-remove>
                <a href="{{ value.url_to_remove }}" class="active-facets__button active-facets__button--light">
                  <span class="active-facets__button-inner button button--tertiary">
                    {{ filter.label | escape }}: {{ value.label | escape }}
                    <span class="svg-wrapper">
                      {{- 'icon-close-small.svg' | inline_asset_content -}}
                    </span>
                    <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                  </span>
                </a>
              </facet-remove>
            {%- endfor -%}

            {%- if filter.type == 'price_range' -%}
              {% assign min = filter.min_value.value %}
              {% assign max = filter.max_value.value %}
              {%- if min != null or max != null -%}
                <facet-remove>
                  <a href="{{ filter.url_to_remove }}" class="active-facets__button active-facets__button--light">
                    <span class="active-facets__button-inner button button--tertiary">
                      {{ min | default: 0 | money }} - {{ max | default: filter.range_max | money }}
                      <span class="svg-wrapper">
                        {{- 'icon-close-small.svg' | inline_asset_content -}}
                      </span>
                      <span class="visually-hidden">{{ 'products.facets.clear_filter' | t }}</span>
                    </span>
                  </a>
                </facet-remove>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if total_active_values > 0 -%}
            <facet-remove class="active-facets__button-wrapper">
              <a href="{{ results_url }}" class="active-facets__button-remove underlined-link">
                <span>{{ 'products.facets.clear_all' | t }}</span>
              </a>
            </facet-remove>
          {%- endif -%}
        </div>
      </form>
    </facet-filters-form>
  {%- endif -%}
</div>

{%- unless _swatch_tooltip_init -%}
  {%- assign _swatch_tooltip_init = true -%}
  <style>
    .facets-layout-grid--swatch {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      padding: 0.8rem 1.5rem;
    }

    .facets__display .facets-layout-grid--swatch {
      padding-top: 3.5rem;
    }

    .mobile-facets__list.facets-layout-grid--swatch {
      padding-top: 3.5rem;
    }

    .facets-layout-grid--swatch .facets__item {
      flex: 0 0 auto;
    }

    .facets-layout-grid--swatch .facets__label {
      padding: 0;
      margin: 0;
    }

    .facets-layout-grid--swatch .swatch-input-wrapper {
      margin: 0;
    }

    .facets-layout-grid--swatch .swatch-input__label {
      border-radius: 50%;
      border: 2px solid transparent;
      outline: none !important;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      cursor: pointer;
      position: relative;
    }

    .facets-layout-grid--swatch .swatch-input__input:checked + .swatch-input__label {
      border-color: #000;
      box-shadow: 0 0 0 2px #fff inset;
      outline: none !important;
    }

    .facets-layout-grid--swatch .swatch-input__input:checked + .swatch-input__label .swatch {
      border-radius: 50%;
    }

    .swatch-input__input:hover + .swatch-input__label .swatch-tooltip {
      visibility: visible;
    }

    .swatch-tooltip {
      visibility: hidden;
      position: absolute;
      bottom: calc(100% + 6px);
      left: 50%;
      transform: translateX(-50%);
      background: #222;
      color: #fff;
      font-size: 1.2rem;
      padding: 4px 10px;
      border-radius: 4px;
      white-space: nowrap;
      pointer-events: none;
      z-index: 999999;
      font-family: var(--font-body-family);
      line-height: 1.4;
    }






  </style>

{%- endunless -%}
