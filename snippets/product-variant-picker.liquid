{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    <style>
      variant-selects .product-form__input {
        width: 100% !important;
        min-width: 100% !important;
        box-sizing: border-box !important;
      }
      .product-form__input--swatch legend.form__label,
      .product-form__input--pill legend.form__label {
        font-weight: 600;
        text-transform: uppercase;
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 0.8rem;
      }
      .product-form__input--pill input[type="radio"] + label {
        border-radius: 0 !important;
        padding: 0.8rem 1.5rem !important;
      }
      .product-form__input--swatch {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 8px !important;
        border: none !important;
        padding: 0 !important;
        margin-bottom: 1.5rem !important;
      }
      .product-form__input--swatch .swatch-input__input {
        position: absolute !important;
        opacity: 0 !important;
        width: 0 !important;
        height: 0 !important;
        pointer-events: none !important;
      }
      .product-form__input--swatch label.swatch-input__label {
        position: relative !important;
        display: inline-block !important;
        border-radius: 0 !important;
        padding: 0 !important;
        margin: 0 !important;
        background-color: #f6f6f6 !important;
        cursor: pointer !important;
        outline: none !important;
        border: 1px solid #e0e0e0 !important;
        box-shadow: none !important;
        transition: border-color 0.2s ease, opacity 0.2s ease !important;
        overflow: visible !important;
      }
      .product-form__input--swatch label.swatch-input__label:hover,
      .product-form__input--swatch .swatch-input__input:hover + label.swatch-input__label {
        border-color: #555555 !important;
        opacity: 1 !important;
        outline: none !important;
        box-shadow: none !important;
      }
      .product-form__input--swatch .swatch-input__input:checked + label.swatch-input__label {
        border-color: #111111 !important;
      }
      .product-form__input--swatch .swatch {
        width: 58px !important;
        height: auto !important;
        aspect-ratio: var(--swatch-aspect-ratio, 0.8) !important;
        border-radius: 0 !important;
        border: none !important;
        background: var(--swatch--background) !important;
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
        display: block !important;
        position: relative !important;
        overflow: hidden !important;
      }
      .product-form__input--swatch .swatch-input__input:checked + label.swatch-input__label::after {
        content: '' !important;
        position: absolute !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 2px !important;
        background-color: #111111 !important;
        z-index: 3 !important;
      }
      .product-form__input--swatch .swatch-input__input:checked + label.swatch-input__label,
      .product-form__input--swatch .swatch-input__input:focus-visible + label.swatch-input__label {
        outline: none !important;
        box-shadow: none !important;
      }
      .product-form__input--swatch label.swatch-input__label .swatch-tooltip {
        visibility: hidden !important;
        opacity: 0 !important;
        position: absolute !important;
        bottom: calc(100% + 8px) !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        background-color: #111111 !important;
        color: #ffffff !important;
        font-size: 11px !important;
        font-weight: 500 !important;
        padding: 4px 8px !important;
        border-radius: 4px !important;
        white-space: nowrap !important;
        pointer-events: none !important;
        z-index: 100 !important;
        transition: opacity 0.2s ease, visibility 0.2s ease !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15) !important;
        line-height: 1.2 !important;
        text-transform: none !important;
      }
      .product-form__input--swatch label.swatch-input__label .swatch-tooltip::after {
        content: '' !important;
        position: absolute !important;
        top: 100% !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        border-width: 4px !important;
        border-style: solid !important;
        border-color: #111111 transparent transparent transparent !important;
      }
      .product-form__input--swatch .swatch-input__input:hover + label.swatch-input__label .swatch-tooltip,
      .product-form__input--swatch label.swatch-input__label:hover .swatch-tooltip {
        visibility: visible !important;
        opacity: 1 !important;
      }
      .mw-size-guide-link {
        font-size: 1rem;
        color: #888;
        text-decoration: none;
        font-weight: 400;
        text-transform: none;
      }
      .mw-size-guide-link:hover {
        text-decoration: underline;
      }
    </style>
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = 'button'
        assign opt_name_down = option.name | downcase
        if opt_name_down == 'color' or opt_name_down == 'colour' or opt_name_down == 'color'
          assign picker_type = 'swatch'
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            <span>{{ option.name | upcase }}: <span style="font-weight: 400;" data-selected-value>{{- option.selected_value -}}</span></span>
            {%- assign opt_down = option.name | downcase -%}
            {%- if opt_down == 'size' or opt_down == 'talla' -%}
              {%- if product.metafields.custom.fit_guide != blank -%}
                <a href="#" class="mw-size-guide-link js-open-size-chart" style="color: #111; text-decoration: underline; font-weight: 500;" onclick="event.preventDefault(); document.getElementById('SizeChartModal-{{ section.id }}').showModal();">Size Chart</a>
              {%- endif -%}
            {%- elsif opt_down == 'color' or opt_down == 'colour' -%}
              <button class="mw-wishlist-inline-btn" type="button" aria-label="Add to wishlist" style="background: transparent; border: none; font-size: 1.3rem; display: flex; align-items: center; gap: 0.5rem; color: #666; cursor: pointer; padding: 0;">
                Add to Wishlist
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="16" height="16" style="margin-top:-2px;">
                  <path d="M10 17.5L3.5 11a4.5 4.5 0 0 1 6.5-6.2 4.5 4.5 0 0 1 6.5 6.2L10 17.5z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </button>
            {%- endif -%}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">
            <span>{{ option.name | upcase }}</span>
            {%- assign opt_down = option.name | downcase -%}
            {%- if opt_down == 'size' or opt_down == 'talla' -%}
              {%- if product.metafields.custom.fit_guide != blank -%}
                <div style="display: flex; gap: 1rem;">
                  <a href="#" class="mw-size-guide-link js-open-size-chart" style="color: #888; text-decoration: underline; font-weight: 500;" onclick="event.preventDefault(); document.getElementById('SizeChartModal-{{ section.id }}').showModal();">Size Chart</a>
                </div>
              {%- endif -%}
            {%- endif -%}
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>

    {%- if product.metafields.custom.fit_guide != blank -%}
      <dialog id="SizeChartModal-{{ section.id }}" class="mw-size-chart-modal" style="padding: 0; border: none; border-radius: 8px; max-width: 90vw; max-height: 90vh; background: transparent; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
        <div style="position: relative; background: #fff; display: flex; flex-direction: column; max-height: 90vh;">
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid #eee;">
            <h3 style="margin: 0; font-size: 1.4rem; text-transform: uppercase; font-family: inherit;">Size Guide</h3>
            <button onclick="document.getElementById('SizeChartModal-{{ section.id }}').close()" style="background: none; border: none; cursor: pointer; padding: 0.5rem; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #f0f0f0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
          <div style="overflow-y: auto; padding: 1.5rem; text-align: center;">
            {{ product.metafields.custom.fit_guide | image_url: width: 1200 | image_tag: style: 'max-width: 100%; height: auto; display: block; margin: 0 auto;' }}
          </div>
        </div>
      </dialog>
      <style>
        dialog.mw-size-chart-modal::backdrop {
          background: rgba(0, 0, 0, 0.6);
          backdrop-filter: blur(2px);
        }
      </style>
      <script>
        document.getElementById('SizeChartModal-{{ section.id }}').addEventListener('click', function(event) {
          if (event.target === this) {
            this.close();
          }
        });
      </script>
    {%- endif -%}
  </variant-selects>
{%- endunless -%}
