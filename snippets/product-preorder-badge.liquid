{%- assign is_coming_soon = false -%}
{%- if collection and collection.handle -%}
  {%- assign current_coll_handle = collection.handle | downcase -%}
  {%- if current_coll_handle == 'coming-soon' -%}
     {%- assign is_coming_soon = true -%}
  {%- endif -%}
{%- endif -%}
{%- if is_coming_soon == false -%}
  {%- for coll in product.collections -%}
    {%- assign coll_handle = coll.handle | downcase -%}
    {%- if coll_handle == 'coming-soon' -%}
      {%- assign is_coming_soon = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if is_coming_soon -%}
<div class="product-preorder-badge">
  COMING SOON
</div>
<style>
.product-preorder-badge {
  display: inline-block;
  background-color: #111;
  color: #fff;
  padding: 0.4rem 0.8rem;
  font-size: 1rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1rem;
  margin-bottom: 1rem;
}
</style>
{%- endif -%}
