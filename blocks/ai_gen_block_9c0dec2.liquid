{% doc %}
  @prompt
    I want shopping tiles in four by five grid up to four tiles that I can upload my ecommerce and lifestyle photography to to make the shopping experience how I want it to look for both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shopping-tiles-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-shopping-tiles__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-shopping-tiles__tile-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: {{ block.settings.aspect_ratio }};
  }

  .ai-shopping-tiles__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-shopping-tiles__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-shopping-tiles__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-shopping-tiles__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  .ai-shopping-tiles__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, {{ block.settings.overlay_opacity }}), transparent);
    padding: {{ block.settings.overlay_padding }}px;
    color: {{ block.settings.text_color }};
    opacity: {% if block.settings.show_overlay_on_hover %}0{% else %}1{% endif %};
    transition: opacity 0.3s ease;
  }

  {% if block.settings.show_overlay_on_hover %}
    .ai-shopping-tiles__tile-{{ ai_gen_id }}:hover .ai-shopping-tiles__overlay-{{ ai_gen_id }} {
      opacity: 1;
    }
  {% endif %}

  .ai-shopping-tiles__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 4px;
  }

  .ai-shopping-tiles__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
  }

  .ai-shopping-tiles__link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-shopping-tiles__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-shopping-tiles-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<shopping-tiles-{{ ai_gen_id }}
  class="ai-shopping-tiles-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shopping-tiles__grid-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign tile_enabled_key = 'tile_' | append: i | append: '_enabled'
        assign image_key = 'tile_' | append: i | append: '_image'
        assign title_key = 'tile_' | append: i | append: '_title'
        assign description_key = 'tile_' | append: i | append: '_description'
        assign link_key = 'tile_' | append: i | append: '_link'

        assign tile_enabled = block.settings[tile_enabled_key]
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
        assign link = block.settings[link_key]
      %}

      {% if tile_enabled %}
        <div class="ai-shopping-tiles__tile-{{ ai_gen_id }}">
          {% if image %}
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
              class="ai-shopping-tiles__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-shopping-tiles__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-shopping-tiles__empty-state-{{ ai_gen_id }}">
                Add image for tile {{ i }}
              </div>
            </div>
          {% endif %}

          {% if title != blank or description != blank %}
            <div class="ai-shopping-tiles__overlay-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-shopping-tiles__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if description != blank %}
                <p class="ai-shopping-tiles__description-{{ ai_gen_id }}">{{ description }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if link != blank %}
            <a
              href="{{ link }}"
              class="ai-shopping-tiles__link-{{ ai_gen_id }}"
              aria-label="{% if title != blank %}{{ title }}{% else %}View tile {{ i }}{% endif %}"
            ></a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</shopping-tiles-{{ ai_gen_id }}>

<script>
  (function() {
    class ShoppingTiles{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('shopping-tiles-{{ ai_gen_id }}', ShoppingTiles{{ ai_gen_id }});
  })();
</script>

